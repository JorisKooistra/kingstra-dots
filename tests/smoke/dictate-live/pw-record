#!/usr/bin/env python3
import sys, time, struct, random, signal, math
out = sys.argv[-1]
import os, json
pattern = json.loads(os.environ.get("PAT","[[0.5,0],[1.5,1],[1.0,0],[2.0,1],[1.0,0],[1.2,1],[3.0,0]]"))
f = open(out, "wb")
f.write(b"RIFF"+struct.pack("<I",0)+b"WAVE"+b"fmt "+struct.pack("<IHHIIHH",16,1,1,16000,32000,2,16)+b"data"+struct.pack("<I",0)); f.flush()
signal.signal(signal.SIGINT, lambda *a: (f.close(), sys.exit(0)))
for dur, loud in pattern:
    n = int(dur*16000); step = 1600
    for i in range(0, n, step):
        amp = 4000 if loud else 60
        f.write(struct.pack("<%dh"%step, *[int(amp*math.sin(j*0.3)+random.randint(-40,40)) for j in range(step)])); f.flush()
        time.sleep(0.1)
while True: time.sleep(0.1)
