#!/usr/bin/env bash
# Compatibiliteit voor bestaande launchers. De eigen picker gebruikt direct
# kingstra-wallpaper; een watcher achter de upstream UI is niet meer nodig.
set -euo pipefail
[[ "${1:-}" == "--watch" ]] && exit 0
exec bash "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/wallpaper-picker-safe.sh"
