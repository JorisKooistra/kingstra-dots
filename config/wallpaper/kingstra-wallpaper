#!/usr/bin/env bash
# =============================================================================
# kingstra-wallpaper — Wallpaper-orchestrator
# =============================================================================
# Gebruik:
#   kingstra-wallpaper set <bestand>       Statisch wallpaper + matugen thema
#   kingstra-wallpaper video <bestand>     Videowallpaper via mpvpaper
#   kingstra-wallpaper random [--video]    Willekeurig uit $KINGSTRA_WALLPAPER_DIR
#   kingstra-wallpaper reload              Herlaad laatste wallpaper (behoudt modus)
#   kingstra-wallpaper pick                Interactieve fzf-kiezer
#   kingstra-wallpaper stop-video          Stop video, herstel statisch
#   kingstra-wallpaper status              Toon huidige wallpaperinformatie
# =============================================================================
set -euo pipefail

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
DEFAULT_WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
SKWD_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/skwd-wall/config.json"
SKWD_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/skwd-wall"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/kingstra"
ACTIVE_THEME_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/active-theme"
THEME_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/theme.json"
STATE_FILE="$CACHE_DIR/last-wallpaper"
IMAGE_STATE_FILE="$CACHE_DIR/last-image-wallpaper"
MODE_FILE="$CACHE_DIR/wallpaper-mode"          # "static" of "video"
LOG_PREFIX="[kingstra-wallpaper]"
SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SCRIPT_REALPATH")/../.." && pwd)"

STATIC_EXTS=("jpg" "jpeg" "png" "webp" "gif")
VIDEO_EXTS=("mp4" "mkv" "webm" "avi" "mov")

MPVPAPER_OPTS="${MPVPAPER_OPTS:---no-audio --loop}"

mkdir -p "$CACHE_DIR"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
_log()  { echo "$LOG_PREFIX $*"; }
_warn() { echo "$LOG_PREFIX WARN: $*" >&2; }
_die()  { echo "$LOG_PREFIX FOUT: $*" >&2; exit 1; }

_expand_user_path() {
    local path="${1:-}"
    case "$path" in
        "~") echo "$HOME" ;;
        "~/"*) echo "$HOME/${path#\~/}" ;;
        *) echo "$path" ;;
    esac
}

_resolve_wallpaper_dir() {
    local cfg_dir=""

    if [[ -n "${KINGSTRA_WALLPAPER_DIR:-}" ]]; then
        cfg_dir="$KINGSTRA_WALLPAPER_DIR"
    elif [[ -f "$SKWD_CONFIG" ]] && command -v jq &>/dev/null; then
        cfg_dir="$(jq -r '.paths.wallpaper // ""' "$SKWD_CONFIG" 2>/dev/null || echo "")"
    fi

    if [[ -z "$cfg_dir" ]]; then
        cfg_dir="$DEFAULT_WALLPAPER_DIR"
    fi

    cfg_dir="$(_expand_user_path "$cfg_dir")"
    [[ "$cfg_dir" = /* ]] || cfg_dir="$HOME/$cfg_dir"
    echo "$(realpath -m "$cfg_dir")"
}

_resolve_video_wallpaper_dir() {
    local cfg_dir=""

    if [[ -f "$SKWD_CONFIG" ]] && command -v jq &>/dev/null; then
        cfg_dir="$(jq -r '.paths.videoWallpaper // ""' "$SKWD_CONFIG" 2>/dev/null || echo "")"
    fi

    if [[ -z "$cfg_dir" ]]; then
        cfg_dir="$WALLPAPER_DIR/video"
    fi

    cfg_dir="$(_expand_user_path "$cfg_dir")"
    [[ "$cfg_dir" = /* ]] || cfg_dir="$HOME/$cfg_dir"
    echo "$(realpath -m "$cfg_dir")"
}

_notify() {
    notify-send --icon=preferences-desktop-wallpaper \
                --app-name="kingstra-wallpaper" \
                "$1" "${2:-}" \
                --urgency=low \
                --expire-time=2000 \
                --transient \
                2>/dev/null || true
}

_run_helper() {
    local helper="$1"
    shift

    if [[ -x "$helper" ]]; then
        "$helper" "$@"
    elif [[ -f "$helper" ]]; then
        case "$(head -n 1 "$helper" 2>/dev/null || true)" in
            *python*) python3 "$helper" "$@" ;;
            *) bash "$helper" "$@" ;;
        esac
    else
        return 127
    fi
}

_cache_wallhaven_tags() {
    local file="$1"
    local helper="${HOME}/.local/bin/kingstra-wallhaven-tags"

    _run_helper "$helper" "$file" >/dev/null 2>&1 || true
}

_is_image() {
    local f="${1,,}"
    for ext in "${STATIC_EXTS[@]}"; do
        [[ "$f" == *."$ext" ]] && return 0
    done
    return 1
}

_is_video() {
    local f="${1,,}"
    for ext in "${VIDEO_EXTS[@]}"; do
        [[ "$f" == *."$ext" ]] && return 0
    done
    return 1
}

_monitors() {
    hyprctl monitors -j 2>/dev/null \
        | python3 -c "import sys,json; [print(m['name']) for m in json.load(sys.stdin)]" \
        2>/dev/null || echo ""
}

_read_skwd_cached_wallpaper() {
    local candidate path=""

    for candidate in \
        "$SKWD_CACHE/current_wallpaper" \
        "$SKWD_CACHE/current-wallpaper" \
        "$SKWD_CACHE/last_wallpaper" \
        "$SKWD_CACHE/last-wallpaper" \
        "$SKWD_CACHE/last-wallpaper.json" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/skwd-wall/state.json"; do
        [[ -f "$candidate" ]] || continue

        if [[ "$candidate" == *.json ]]; then
            command -v jq >/dev/null 2>&1 || continue
            path="$(jq -r '.path // .wallpaper // .currentWallpaper // .lastWallpaper // ""' "$candidate" 2>/dev/null || echo "")"
        else
            path="$(cat "$candidate" 2>/dev/null || true)"
        fi

        path="$(_expand_user_path "$path")"
        if [[ -n "$path" && -f "$path" ]]; then
            printf '%s\n' "$path"
            return 0
        fi
    done

    return 1
}

_current_static_wallpaper() {
    # skwd is de enige bron van waarheid. Voorheen werd hier eerst `awww query`
    # geraadpleegd; zolang awww-daemon nog draaide met een oud beeld won die
    # oude keuze het bij elke reload van de zojuist via skwd gekozen wallpaper.
    local candidate=""

    candidate="$(_read_skwd_cached_wallpaper || true)"
    if [[ -n "$candidate" && -f "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi

    return 1
}

_path_matches() {
    local left="${1:-}" right="${2:-}"
    [[ -n "$left" && -n "$right" ]] || return 1
    [[ "$(realpath -m "$left" 2>/dev/null || printf '%s' "$left")" == "$(realpath -m "$right" 2>/dev/null || printf '%s' "$right")" ]]
}

WALLPAPER_DIR="$(_resolve_wallpaper_dir)"
VIDEO_WALLPAPER_DIR="$(_resolve_video_wallpaper_dir)"

# ---------------------------------------------------------------------------
# Backend: statisch (skwd)
# ---------------------------------------------------------------------------
_stop_video() {
    if pgrep -x mpvpaper &>/dev/null; then
        pkill -x mpvpaper 2>/dev/null || true
        sleep 0.2
        _log "mpvpaper gestopt"
    fi
}

_set_static() {
    local file="$1"
    [[ -f "$file" ]] || _die "Bestand niet gevonden: $file"

    _stop_video

    # skwd is de enige wallpaper-daemon: het rendert, levert de picker-UI
    # (Super+Ctrl+W) en doet de kleuranalyse. Voorheen draaide awww er als
    # tweede renderer naast; skwd-paper ligt bovenop awww, dus je zag skwd's
    # beeld terwijl de kingstra-state awww's keuze bevatte -> desync/flicker.
    if ! command -v skwd &>/dev/null; then
        _warn "skwd niet gevonden — kan wallpaper niet instellen"
        return 1
    fi

    # Prime alle state vóór de zichtbare apply. skwd-postprocessing en
    # apply-shell-state kunnen direct daarna gaan lezen; met de oude volgorde
    # konden zij nog één cyclus het vorige pad terugzetten.
    _save_state "$file" "static"
    _update_wallpaper_json "$file"
    _sync_skwd_current_wallpaper "$file" "static"

    if skwd wall apply "{\"path\":\"$file\"}" >/dev/null 2>&1; then
        _log "Statisch wallpaper ingesteld via skwd: $(basename "$file")"
        return 0
    fi

    _warn "skwd kon wallpaper niet instellen: $file"
    return 1
}

# ---------------------------------------------------------------------------
# Backend: video (mpvpaper)
# ---------------------------------------------------------------------------
_set_video() {
    local file="$1"
    [[ -f "$file" ]] || _die "Bestand niet gevonden: $file"

    if ! command -v mpvpaper &>/dev/null; then
        _warn "mpvpaper niet geïnstalleerd — val terug op statisch"
        _set_static_fallback_for_video "$file"
        return 0
    fi

    _stop_video

    # Start mpvpaper op alle monitors
    while IFS= read -r monitor; do
        [[ -z "$monitor" ]] && continue
        mpvpaper $MPVPAPER_OPTS "$monitor" "$file" &
        disown
    done < <(_monitors)

    _log "Videowallpaper gestart: $(basename "$file")"
}

_set_static_fallback_for_video() {
    # Gebruik een eventuele thumbnailafbeelding of de huidige static state
    local current
    current="$(cat "$STATE_FILE" 2>/dev/null || echo "")"
    if [[ -f "$current" ]] && _is_image "$current"; then
        _set_static "$current"
    fi
}

# ---------------------------------------------------------------------------
# State opslaan
# ---------------------------------------------------------------------------
_save_state() {
    local file="$1" mode="$2"
    echo "$file"  > "$STATE_FILE"
    echo "$mode"  > "$MODE_FILE"
    if [[ "$mode" == "static" ]]; then
        echo "$file" > "$IMAGE_STATE_FILE"
    fi
}

_update_wallpaper_json() {
    local file="$1"
    local state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/state"
    local wjson="$state_dir/wallpaper.json"

    mkdir -p "$state_dir"

    jq -n \
        --arg name "$(basename "$file")" \
        --arg path "$file" \
        '{"name":$name,"path":$path}' \
        > "$wjson" || true

    _log "wallpaper.json bijgewerkt: $(basename "$file")"
}

_sync_skwd_current_wallpaper() {
    local file="$1" mode="${2:-static}"
    [[ -n "$file" && -f "$file" ]] || return 0

    mkdir -p "$SKWD_CACHE"
    printf '%s\n' "$file" > "$SKWD_CACHE/current_wallpaper"
    printf '%s\n' "$file" > "$SKWD_CACHE/current-wallpaper"
    printf '%s\n' "$file" > "$SKWD_CACHE/last_wallpaper"
    printf '%s\n' "$file" > "$SKWD_CACHE/last-wallpaper"

    if command -v jq &>/dev/null; then
        jq -n --arg path "$file" --arg type "$mode" \
            '{"path":$path,"type":$type}' \
            > "$SKWD_CACHE/last-wallpaper.json" 2>/dev/null || true
    fi
}

_active_theme() {
    local theme=""

    if [[ -f "$ACTIVE_THEME_FILE" ]]; then
        theme="$(cat "$ACTIVE_THEME_FILE" 2>/dev/null || true)"
    fi

    if [[ -z "$theme" && -f "$THEME_JSON" ]] && command -v jq >/dev/null 2>&1; then
        theme="$(jq -r '.theme // ""' "$THEME_JSON" 2>/dev/null || true)"
    fi

    printf '%s\n' "${theme,,}"
}

_is_generated_theme_wallpaper() {
    local file="${1:-}"
    [[ "$file" == "$CACHE_DIR/theme-wallpapers/"* ]]
}

_theme_wallpaper_source() {
    local current="${1:-}"
    local original_file="$CACHE_DIR/theme-wallpaper-source"

    if _is_generated_theme_wallpaper "$current" && [[ -f "$original_file" ]]; then
        cat "$original_file" 2>/dev/null || true
        return 0
    fi

    printf '%s\n' "$current"
}

_theme_wallpaper_for() {
    local theme_name="$1"
    local source="$2"
    local requested="$source"
    local target_dir target_file target_tmp hash original_file effect_key mono_accent_helper

    [[ -n "$source" && -f "$source" ]] || {
        printf '%s\n' "$source"
        return 0
    }

    if ! command -v magick >/dev/null 2>&1; then
        _warn "ImageMagick ontbreekt — theme wallpaper blijft origineel"
        printf '%s\n' "$source"
        return 0
    fi

    mkdir -p "$CACHE_DIR"
    original_file="$CACHE_DIR/theme-wallpaper-source"
    source="$(_theme_wallpaper_source "$source")"
    if [[ -z "$source" || ! -f "$source" ]]; then
        printf '%s\n' "$requested"
        return 0
    fi
    printf '%s\n' "$source" > "$original_file"

    case "$theme_name" in
        paper) effect_key="paper-sketch-v6" ;;
        neon)  effect_key="neon-glass-tint-v1" ;;
        mono-accent) effect_key="mono-accent-splash-v1" ;;
        *)     effect_key="mono-gray-v1" ;;
    esac
    hash="$(printf '%s:%s:%s:%s' "$effect_key" "$source" "$(stat -c '%Y' "$source" 2>/dev/null || echo 0)" "$(stat -c '%s' "$source" 2>/dev/null || echo 0)" | sha1sum | awk '{print $1}')"
    target_dir="$CACHE_DIR/theme-wallpapers/$theme_name"
    mkdir -p "$target_dir"
    target_file="$target_dir/${hash}.jpg"

    # skwd kan dit doel direct na de state-update openen. Bouw daarom op een
    # uniek tijdelijk pad en publiceer uitsluitend een volledig geldige JPEG.
    if [[ ! -s "$target_file" ]] || ! magick identify "$target_file" >/dev/null 2>&1; then
        target_tmp="$(mktemp "$target_dir/.${hash}.XXXXXX.jpg")"
        if [[ "$theme_name" == "paper" ]]; then
            if ! magick "$source" -auto-orient -colorspace Gray \
                \( +clone -negate -blur 0x18 \) -compose ColorDodge -composite \
                -blur 0x0.75 -level 12%,98%,0.88 \
                -colorspace sRGB -type TrueColor \
                -fill "#c7a16b" -tint 42% \
                -fill "#f3e0bd" -colorize 12% \
                -attenuate 0.018 +noise Gaussian \
                -quality 92 "$target_tmp"; then
                rm -f "$target_tmp"
                _warn "Paper-wallpaper kon niet worden gegenereerd"
                printf '%s\n' "$requested"
                return 0
            fi
        elif [[ "$theme_name" == "neon" ]]; then
            if ! magick "$source" -auto-orient -colorspace sRGB \
                -modulate 100,104,100 \
                -fill "#00b7ff" -colorize 4% \
                -fill "#06131d" -colorize 2% \
                -quality 92 "$target_tmp"; then
                rm -f "$target_tmp"
                _warn "Neon-wallpaper kon niet worden gegenereerd"
                printf '%s\n' "$requested"
                return 0
            fi
        elif [[ "$theme_name" == "mono-accent" ]]; then
            mono_accent_helper="${HOME}/.local/bin/kingstra-mono-accent"
            [[ -f "$mono_accent_helper" ]] || mono_accent_helper="$REPO_ROOT/config/shared/scripts/kingstra-mono-accent"
            if ! _run_helper "$mono_accent_helper" wallpaper "$source" "$target_tmp"; then
                _warn "Mono Accent color splash mislukt — grijze fallback gebruikt"
                if ! magick "$source" -auto-orient -colorspace Gray -modulate 100,0,100 -quality 92 "$target_tmp"; then
                    rm -f "$target_tmp"
                    _warn "Mono Accent fallback-wallpaper kon niet worden gegenereerd"
                    printf '%s\n' "$requested"
                    return 0
                fi
            fi
        else
            if ! magick "$source" -auto-orient -colorspace Gray -modulate 100,0,100 -quality 92 "$target_tmp"; then
                rm -f "$target_tmp"
                _warn "Mono-wallpaper kon niet worden gegenereerd"
                printf '%s\n' "$requested"
                return 0
            fi
        fi

        if ! magick identify "$target_tmp" >/dev/null 2>&1; then
            rm -f "$target_tmp"
            _warn "Gegenereerde theme-wallpaper is ongeldig"
            printf '%s\n' "$requested"
            return 0
        fi
        chmod 644 "$target_tmp"
        mv -f "$target_tmp" "$target_file"
    fi

    printf '%s\n' "$target_file"
}

_prepare_static_for_active_theme() {
    local file="$1"
    local theme_name
    theme_name="$(_active_theme)"

    if [[ "$theme_name" == "mono" || "$theme_name" == "mono-accent" || "$theme_name" == "paper" || "$theme_name" == "neon" ]] && _is_image "$file"; then
        _theme_wallpaper_for "$theme_name" "$file"
        return 0
    fi

    printf '%s\n' "$file"
}

_apply_skwd_wallpaper() {
    local name="$1" file="$2" mode="$3"
    local source_file="$file" current_file=""
    local payload

    if [[ "$mode" == "static" ]]; then
        file="$(_prepare_static_for_active_theme "$file")"
        name="$(basename "$file")"
    fi

    command -v skwd >/dev/null 2>&1 || return 1
    command -v jq >/dev/null 2>&1 || return 1

    current_file="$(_current_static_wallpaper || true)"
    _save_state "$file" "$mode"
    _update_wallpaper_json "$file"
    _sync_skwd_current_wallpaper "$file" "$mode"
    _run_helper "${HOME}/.local/bin/kingstra-session-update" 2>/dev/null || true

    if [[ "$mode" == "static" ]] && _path_matches "$current_file" "$file"; then
        _log "Wallpaper al actief via skwd: $(basename "$file")"
    else
        payload="$(jq -cn --arg name "$name" --arg path "$file" --arg type "$mode" \
            '{name:$name,path:$path,type:$type}')"
        skwd wall apply "$payload" >/dev/null 2>&1 || return 1
    fi

    local APPLY="${HOME}/.local/bin/apply-shell-state"
    if [[ -f "$APPLY" ]]; then
        _run_helper "$APPLY" --wallpaper "$file"
    else
        _notify "Wallpaper ingesteld" "$(basename "$file")"
    fi
    _cache_wallhaven_tags "$source_file"
}

_cmd_random_via_skwd() {
    local mode="$1" want_type entry name file

    command -v skwd >/dev/null 2>&1 || return 1
    command -v jq >/dev/null 2>&1 || return 1

    if [[ "$mode" == "video" ]]; then
        want_type="video"
    else
        want_type="static"
    fi

    entry="$(
        skwd wall list 2>/dev/null \
            | jq -r --arg type "$want_type" \
                    --arg wallpaper_dir "$WALLPAPER_DIR" \
                    --arg video_dir "$VIDEO_WALLPAPER_DIR" '
                .wallpapers[]?
                | select(.type == $type)
                | select((.name // "") != "")
                | [
                    .name,
                    (if .type == "video" then
                        ((.video_file // "") as $vf | if $vf != "" then $vf else ($video_dir + "/" + .name) end)
                      else
                        ($wallpaper_dir + "/" + .name)
                      end)
                  ]
                | @tsv
            ' \
            | shuf -n 1
    )" || return 1

    [[ -n "$entry" ]] || return 1
    IFS=$'\t' read -r name file <<< "$entry"
    [[ -n "$name" && -f "$file" ]] || return 1

    _apply_skwd_wallpaper "$name" "$file" "$mode"
}

# ---------------------------------------------------------------------------
# Commando's
# ---------------------------------------------------------------------------
cmd_set() {
    local file="${1:-}"
    [[ -z "$file" ]] && _die "Gebruik: kingstra-wallpaper set <bestand>"
    file="$(realpath "$file")"

    local source_file="$file"
    file="$(_prepare_static_for_active_theme "$file")"

    _set_static "$file"
    _run_helper "${HOME}/.local/bin/kingstra-session-update" 2>/dev/null || true

    # Kleuren genereren + apps herladen
    APPLY="${HOME}/.local/bin/apply-shell-state"
    if [[ -f "$APPLY" ]]; then
        _run_helper "$APPLY" --wallpaper "$file"
    else
        _warn "apply-shell-state niet gevonden — alleen wallpaper ingesteld"
        _notify "Wallpaper ingesteld" "$(basename "$file")"
    fi
    _cache_wallhaven_tags "$source_file"
}

cmd_video() {
    local file="${1:-}"
    [[ -z "$file" ]] && _die "Gebruik: kingstra-wallpaper video <bestand>"
    file="$(realpath "$file")"

    _set_video "$file"
    _save_state "$file" "video"
    _update_wallpaper_json "$file"
    _sync_skwd_current_wallpaper "$file" "video"
    _run_helper "${HOME}/.local/bin/kingstra-session-update" 2>/dev/null || true

    local last_image
    last_image="$(cat "$IMAGE_STATE_FILE" 2>/dev/null || echo "")"
    if [[ -f "$last_image" ]]; then
        local APPLY="${HOME}/.local/bin/apply-shell-state"
        if [[ -f "$APPLY" ]]; then
            _run_helper "$APPLY" --wallpaper "$last_image" 2>/dev/null || true
        fi
    fi

    _notify "Videowallpaper" "$(basename "$file")"
    _cache_wallhaven_tags "$file"
}

cmd_random() {
    local video_mode=false
    [[ "${1:-}" == "--video" ]] && video_mode=true

    if $video_mode; then
        _cmd_random_via_skwd "video" && return 0
    else
        _cmd_random_via_skwd "static" && return 0
    fi

    # Bouw zoekpatroon
    local find_args=(-maxdepth 3 -type f)
    if $video_mode; then
        find_args+=( \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.webm" -o -iname "*.avi" -o -iname "*.mov" \) )
    else
        find_args+=( \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) )
    fi

    [[ -d "$WALLPAPER_DIR" ]] || _die "Wallpaper-map niet gevonden: $WALLPAPER_DIR"

    local file
    file="$(find "$WALLPAPER_DIR" "${find_args[@]}" 2>/dev/null | shuf -n 1)"
    [[ -z "$file" ]] && _die "Geen wallpapers gevonden in $WALLPAPER_DIR"

    if $video_mode; then
        cmd_video "$file"
    else
        cmd_set "$file"
    fi
}

cmd_reload() {
    local file mode state_file active_file
    state_file="$(cat "$STATE_FILE" 2>/dev/null || echo "")"
    file="$state_file"
    mode="$(cat "$MODE_FILE" 2>/dev/null || echo "static")"

    if [[ "$mode" != "video" ]]; then
        active_file="$(_current_static_wallpaper || true)"
        if [[ -n "$active_file" && -f "$active_file" ]]; then
            file="$active_file"

            if [[ "$active_file" != "$state_file" ]]; then
                _save_state "$active_file" "static"
                _update_wallpaper_json "$active_file"
                _sync_skwd_current_wallpaper "$active_file" "static"
                _run_helper "${HOME}/.local/bin/kingstra-session-update" 2>/dev/null || true
                _log "Actieve wallpaper overgenomen uit runtime-state: $(basename "$active_file")"
            fi
        fi
    fi

    if [[ -z "$file" ]]; then
        _warn "Geen opgeslagen wallpaper — kies willekeurig"
        cmd_random
        return 0
    fi

    if [[ ! -f "$file" ]]; then
        _warn "Opgeslagen wallpaper niet gevonden: $file"
        cmd_random
        return 0
    fi

    if [[ "$mode" == "video" ]]; then
        _set_video "$file"
        local last_image
        last_image="$(cat "$IMAGE_STATE_FILE" 2>/dev/null || echo "")"
        if [[ -f "$last_image" ]]; then
            last_image="$(_prepare_static_for_active_theme "$last_image")"
            local APPLY="${HOME}/.local/bin/apply-shell-state"
            [[ -f "$APPLY" ]] && _run_helper "$APPLY" --wallpaper "$last_image" 2>/dev/null || true
        fi
    else
        local source_file="$file"
        file="$(_prepare_static_for_active_theme "$file")"
        if [[ "$file" != "$source_file" ]]; then
            _save_state "$file" "static"
            _update_wallpaper_json "$file"
            _sync_skwd_current_wallpaper "$file" "static"
            _run_helper "${HOME}/.local/bin/kingstra-session-update" 2>/dev/null || true
        fi
        _set_static "$file"
        # Herlaad kleuren + apps
        APPLY="${HOME}/.local/bin/apply-shell-state"
        [[ -f "$APPLY" ]] && _run_helper "$APPLY" --wallpaper "$file" 2>/dev/null || true
    fi

    _log "Wallpaper herladen: $(basename "$file") [$mode]"
}

cmd_pick() {
    if ! command -v fzf &>/dev/null; then
        _die "fzf niet geïnstalleerd — installeer fzf voor de picker"
    fi

    [[ -d "$WALLPAPER_DIR" ]] || _die "Wallpaper-map niet gevonden: $WALLPAPER_DIR"

    local preview_cmd=""
    if command -v chafa &>/dev/null; then
        preview_cmd="chafa --size=\$((FZF_PREVIEW_COLUMNS))x\$((FZF_PREVIEW_LINES)) {}"
    elif command -v kitty &>/dev/null; then
        preview_cmd="kitty +kitten icat --clear --transfer-mode=memory --stdin=no --place \${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES}@0x0 {} 2>/dev/null || file {}"
    else
        preview_cmd="file {}"
    fi

    local file
    file="$(find "$WALLPAPER_DIR" -maxdepth 3 -type f \
        \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \
           -o -iname "*.webp" -o -iname "*.mp4" -o -iname "*.mkv" \
           -o -iname "*.webm" \) \
        2>/dev/null | sort | \
        fzf --prompt="Wallpaper > " \
            --preview="$preview_cmd" \
            --preview-window=right:60%:wrap \
            --bind="ctrl-v:execute(kingstra-wallpaper video {})+abort" \
            --header="Enter=statisch  Ctrl-V=video  Esc=annuleer")"

    [[ -z "$file" ]] && { _log "Geannuleerd"; exit 0; }

    if _is_video "$file"; then
        cmd_video "$file"
    else
        cmd_set "$file"
    fi
}

cmd_stop_video() {
    _stop_video

    # Herstel laatste statisch wallpaper
    local file
    file="$(cat "$IMAGE_STATE_FILE" 2>/dev/null || echo "")"
    if [[ -f "$file" ]] && _is_image "$file"; then
        file="$(_prepare_static_for_active_theme "$file")"
        _set_static "$file"
        echo "static" > "$MODE_FILE"
        _save_state "$file" "static"
        _sync_skwd_current_wallpaper "$file" "static"
        local APPLY="${HOME}/.local/bin/apply-shell-state"
        [[ -f "$APPLY" ]] && _run_helper "$APPLY" --wallpaper "$file" 2>/dev/null || true
        _log "Statisch wallpaper hersteld: $(basename "$file")"
    else
        _warn "Geen statisch wallpaper in state — gebruik: kingstra-wallpaper set <bestand>"
    fi
}

cmd_status() {
    local file mode
    file="$(cat "$STATE_FILE" 2>/dev/null || echo "(geen)")"
    mode="$(cat "$MODE_FILE" 2>/dev/null || echo "static")"

    echo "Modus:     $mode"
    echo "Map:       $WALLPAPER_DIR"
    echo "Bestand:   $file"

    if pgrep -x mpvpaper &>/dev/null; then
        echo "mpvpaper:  actief"
    else
        echo "mpvpaper:  gestopt"
    fi

    if pgrep -f skwd-daemon &>/dev/null; then
        echo "skwd:      actief"
    else
        echo "skwd:      gestopt"
    fi

}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
CMD="${1:-}"
shift || true

case "$CMD" in
    set)         cmd_set "$@" ;;
    video)       cmd_video "$@" ;;
    random)      cmd_random "$@" ;;
    reload)      cmd_reload ;;
    pick)        cmd_pick ;;
    stop-video)  cmd_stop_video ;;
    status)      cmd_status ;;
    "")          _die "Geen commando opgegeven. Gebruik: kingstra-wallpaper <commando>" ;;
    *)           _die "Onbekend commando: $CMD" ;;
esac
