[Unit]
Description=Kingstra koppeling: muis en toetsenbord delen (lan-mouse)
Documentation=https://github.com/JorisKooistra/kingstra-dots
# Gestart door kingstra-session-start zodra er een koppeling is.
ConditionPathExists=%h/.config/kingstra/koppeling.json

[Service]
Type=simple
# Eerst het IP van de ander verversen (die kan na een herstart een ander
# bronadres gebruiken). Mislukt dat, dan gewoon met het opgeslagen IP door.
ExecStartPre=-/usr/bin/timeout 8 %h/.local/bin/kingstra-koppel _ververs-ip
ExecStart=/usr/bin/lan-mouse daemon
Restart=on-failure
RestartSec=3
Environment=XDG_RUNTIME_DIR=/run/user/%U
