[Unit]
Description=Kingstra koppeling: klembord delen met de gekoppelde machine
Documentation=https://github.com/JorisKooistra/kingstra-dots
# Gestart door kingstra-session-start zodra er een koppeling is.
ConditionPathExists=%h/.config/kingstra/koppeling.json

[Service]
Type=simple
ExecStart=%h/.local/bin/kingstra-koppel klembord
Restart=on-failure
RestartSec=3
Environment=XDG_RUNTIME_DIR=/run/user/%U
