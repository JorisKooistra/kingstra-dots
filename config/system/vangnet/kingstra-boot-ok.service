[Unit]
Description=Kingstra: opstart geslaagd zodra inlogscherm of bureaublad echt draait
Documentation=man:systemd-bless-boot.service(8)
DefaultDependencies=no
Requires=display-manager.service
After=display-manager.service
Before=boot-complete.target

[Service]
Type=oneshot
TimeoutStartSec=150
# Alleen "display-manager actief" was niet genoeg: op 4 november bleef SDDM
# achter een grijs scherm hangen en werd de start toch goedgekeurd. Nu moet
# de greeter (of al een Hyprland-sessie) echt draaien, en 5 s later nog steeds.
ExecStart=/bin/sh -c 'up(){ pgrep -x sddm-greeter-qt6 >/dev/null || pgrep -x sddm-greeter >/dev/null || pgrep -x Hyprland >/dev/null; }; i=0; while [ $i -lt 60 ]; do if up; then sleep 5; up && exit 0; fi; sleep 2; i=$((i+1)); done; exit 1'

[Install]
RequiredBy=boot-complete.target
