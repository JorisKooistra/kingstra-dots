// /etc/polkit-1/rules.d/50-kingstra-udisks.rules — geplaatst door kingstra-dots
// Interne en externe dataschijven mounten zonder wachtwoord, zodat
// kingstra-disks ze bij het inloggen kan koppelen en Files ze toont.
// Alleen voor een actieve, lokale gebruiker in de groep wheel, en alleen
// mounten en uitwerpen: formatteren, partitioneren en ontgrendelen blijven
// een wachtwoord vragen.
polkit.addRule(function (action, subject) {
    var allowed = [
        "org.freedesktop.udisks2.filesystem-mount",
        "org.freedesktop.udisks2.filesystem-mount-system",
        "org.freedesktop.udisks2.eject-media",
        "org.freedesktop.udisks2.eject-media-system",
        "org.freedesktop.udisks2.power-off-drive",
        "org.freedesktop.udisks2.power-off-drive-system"
    ];
    if (allowed.indexOf(action.id) >= 0 &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
