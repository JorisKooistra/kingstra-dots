// =============================================================================
// fastfetch/config.jsonc — kingstra-dots
// =============================================================================
// Kingstra-kroon links, systeeminfo rechts in drie groepen met een boomlijn.
//
// Kleuren: alleen de 16 terminalkleuren. Kitty krijgt die van matugen
// (templates/kitty-colors.conf), dus fastfetch volgt vanzelf het thema:
//   blue        = accent 1 (focus)      -> sleutels, kroon
//   green       = accent 2 (activiteit) -> balkjes, waarden onder 60%
//   magenta     = accent 3 (attentie)   -> kopjes, kroonjuwelen
//   light_black = outline               -> boomlijnen, rustige tekst
// Let op: schrijf "light_black", niet "bright_black" (dat wordt vet + zwart),
// en gebruik alleen kleurnamen die fastfetch kent; een onbekende naam laat
// fastfetch helemaal stoppen.
//
// Regels worden afgekapt in plaats van afgebroken, zodat het logo nooit
// verschuift in een smal venster.
// =============================================================================
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/kingstra.txt",
        "color": {
            "1": "blue",
            "2": "magenta",
            "3": "light_black"
        },
        "padding": {
            "top": 3,
            "left": 3,
            "right": 4
        }
    },

    "display": {
        "separator": " ",
        "disableLinewrap": true,
        "color": {
            "keys": "blue",
            "title": "blue",
            "separator": "light_black"
        },
        "key": {
            "width": 16
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "border": null,
            "width": 12,
            "color": {
                "total": "light_black"
            }
        },
        "percent": {
            "type": ["num", "num-color"],
            "color": {
                "green": "green",
                "yellow": "light_yellow",
                "red": "light_red"
            }
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{#bold_blue}{user-name}{#}{#light_black} @ {#}{#bold_magenta}{host-name}{#}"
        },
        {
            "type": "custom",
            "format": "{#light_black}╭─{#} {#magenta}systeem{#} {#light_black}──────────────────────────────{#}"
        },
        {
            "type": "os",
            "key": "{#light_black}│{#} {#blue}󰣇  OS",
            "format": "{pretty-name}"
        },
        {
            "type": "kernel",
            "key": "{#light_black}│{#} {#blue}  Kernel",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "{#light_black}│{#} {#blue}󰔚  Looptijd",
            "format": "{?days}{days}d {?}{?hours}{hours}u {?}{minutes}m"
        },
        {
            "type": "packages",
            "key": "{#light_black}│{#} {#blue}󰏗  Pakketten",
            "format": "{pacman} pacman{?flatpak-all}{#light_black} · {#}{flatpak-all} flatpak{?}"
        },
        {
            "type": "command",
            "key": "{#light_black}│{#} {#blue}󰏘  Thema",
            "text": "t=$(cat \"${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/active-theme\" 2>/dev/null); t=${t:-standaard}; printf '%s' \"$t\" | awk '{print toupper(substr($0,1,1)) substr($0,2)}'"
        },
        {
            "type": "custom",
            "format": "{#light_black}├─{#} {#magenta}bureaublad{#} {#light_black}───────────────────────────{#}"
        },
        {
            "type": "wm",
            "key": "{#light_black}│{#} {#blue}󱂬  WM",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "display",
            "key": "{#light_black}│{#} {#blue}󰍹  Scherm",
            "format": "{width}×{height} @ {refresh-rate} Hz"
        },
        {
            "type": "shell",
            "key": "{#light_black}│{#} {#blue}  Shell"
        },
        {
            "type": "terminal",
            "key": "{#light_black}│{#} {#blue}  Terminal"
        },
        {
            "type": "terminalfont",
            "key": "{#light_black}│{#} {#blue}  Lettertype",
            "format": "{name}{#light_black} · {#}{size}pt"
        },
        {
            "type": "custom",
            "format": "{#light_black}├─{#} {#magenta}hardware{#} {#light_black}─────────────────────────────{#}"
        },
        {
            "type": "cpu",
            "key": "{#light_black}│{#} {#blue}  CPU",
            "format": "{name}{#light_black} · {#}{cores-physical}C/{cores-logical}T"
        },
        {
            "type": "gpu",
            "key": "{#light_black}│{#} {#blue}󰢮  GPU",
            "format": "{name}",
            "detectionMethod": "pci"
        },
        {
            "type": "memory",
            "key": "{#light_black}│{#} {#blue}  Geheugen",
            "format": "{percentage-bar} {used}{#light_black} / {total}{#}"
        },
        {
            "type": "disk",
            "key": "{#light_black}│{#} {#blue}󰋊  Schijf",
            "folders": "/",
            "format": "{size-percentage-bar} {size-used}{#light_black} / {size-total}{#}"
        },
        {
            "type": "localip",
            "key": "{#light_black}│{#} {#blue}󰩟  Netwerk",
            "showIpv4": true,
            "showIpv6": false,
            "showPrefixLen": false
        },
        {
            "type": "custom",
            "format": "{#light_black}╰───────────────────────────────────────{#}"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
