#!/usr/bin/env bash
# =============================================================================
# kingstra-mode-switch — Wissel tussen Kingstra modes
# =============================================================================
# Gebruik: kingstra-mode-switch <mode_naam>
#          kingstra-mode-switch --current    (print huidige mode)
#          kingstra-mode-switch --list       (lijst beschikbare modes)
# =============================================================================
set -euo pipefail

MODES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/modes"
LOG_PREFIX="[kingstra-mode-switch]"

_log()  { echo "$LOG_PREFIX $*"; }
_warn() { echo "$LOG_PREFIX WARN: $*" >&2; }

_notify() {
    notify-send --icon=preferences-system \
                --app-name="kingstra" \
                "$1" "${2:-}" \
                --urgency=low \
                --expire-time=3000 \
                2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Argumenten
# ---------------------------------------------------------------------------
if [[ "${1:-}" == "--current" ]]; then
    jq -r '.name // "office"' \
        "${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/state/mode.json" 2>/dev/null \
        || echo "office"
    exit 0
fi

# Beschikbare modes komen uit de TOML's in MODES_DIR (bron van waarheid);
# fallback op de standaard drie als de directory ontbreekt.
_available_modes() {
    local found=false f
    for f in "$MODES_DIR"/*.toml; do
        [[ -f "$f" ]] || continue
        basename "$f" .toml
        found=true
    done
    if ! $found; then
        printf '%s\n' office gaming media
    fi
}

if [[ "${1:-}" == "--list" ]]; then
    _available_modes
    exit 0
fi

MODE_NAME="${1:?Gebruik: kingstra-mode-switch <mode_naam>}"

# Valideer mode naam
if ! _available_modes | grep -qx "$MODE_NAME"; then
    _warn "Onbekende mode: $MODE_NAME (geldig: $(_available_modes | paste -sd ', '))"
    exit 1
fi

_log "Overschakelen naar mode: $MODE_NAME"

# ---------------------------------------------------------------------------
# Stap 1 — Schrijf mode.json (incl. bar_autohide/modules, meteen — niet pas
# na afloop van apply-shell-state's trage matugen/theming-pipeline. Die
# vertraging zorgde ervoor dat bv. media-mode's autohide pas na tientallen
# seconden inging in plaats van meteen bij het wisselen.)
# ---------------------------------------------------------------------------
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/state"
mkdir -p "$STATE_DIR"
MODE_JSON="$STATE_DIR/mode.json"
MODE_TOML="$MODES_DIR/${MODE_NAME}.toml"
MODE_READ="${HOME}/.local/bin/kingstra-mode-read"

MODULES="[]"
AUTOHIDE="false"
if [[ -x "$MODE_READ" && -f "$MODE_TOML" ]]; then
    MODE_DATA=$("$MODE_READ" --json "$MODE_TOML" 2>/dev/null || echo "{}")
    MODULES=$(echo "$MODE_DATA" | jq -c '.modules.list // []' 2>/dev/null || echo "[]")
    AUTOHIDE=$(echo "$MODE_DATA" | jq -r '.bar.autohide // false' 2>/dev/null || echo "false")
fi

TMP="$(mktemp "$MODE_JSON.XXXXXX")"
jq -n \
    --arg name "$MODE_NAME" \
    --argjson modules "$MODULES" \
    --argjson bar_autohide "$AUTOHIDE" \
    '{"name":$name,"modules":$modules,"bar_autohide":$bar_autohide}' \
    > "$TMP"
chmod 644 "$TMP"
mv "$TMP" "$MODE_JSON"
_log "state/mode.json bijgewerkt: $MODE_NAME (autohide=$AUTOHIDE)"

# ---------------------------------------------------------------------------
# Stap 2 — session.json synchroniseren
# ---------------------------------------------------------------------------
SESSION_UPDATE="${HOME}/.local/bin/kingstra-session-update"
if [[ -x "$SESSION_UPDATE" ]]; then
    "$SESSION_UPDATE"
    _log "session.json bijgewerkt"
fi

# ---------------------------------------------------------------------------
# Stap 3 — Apply shell state (matugen + reloads)
# ---------------------------------------------------------------------------
APPLY="${HOME}/.local/bin/apply-shell-state"
if [[ -x "$APPLY" ]]; then
    "$APPLY" || _warn "apply-shell-state mislukt"
    _log "Shell state toegepast"
fi

_notify "Mode: $MODE_NAME" "Modus succesvol ingesteld"
