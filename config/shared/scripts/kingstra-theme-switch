#!/usr/bin/env bash
# =============================================================================
# kingstra-theme-switch — Switch between Kingstra themes
# =============================================================================
# Usage: kingstra-theme-switch <theme_name>
#        kingstra-theme-switch --current         (print current theme)
#        kingstra-theme-switch --list             (list available themes)
# =============================================================================
set -euo pipefail

THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/themes"
ACTIVE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/active-theme"
THEME_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/conf.d/35-theme.conf"
THEME_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/theme.json"
MATUGEN_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/matugen/config.toml"
SKWD_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/skwd-wall/config.json"
SKWD_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/skwd-wall"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/state"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/kingstra"
DEFAULT_THEME="organic"

APPLY=""

LOG_PREFIX="[kingstra-theme-switch]"
_log()  { echo "$LOG_PREFIX $*"; }
_warn() { echo "$LOG_PREFIX WARN: $*" >&2; }

run_helper() {
    local helper="$1"
    shift

    if [[ -x "$helper" ]]; then
        "$helper" "$@"
    elif [[ -f "$helper" ]]; then
        case "$(head -n 1 "$helper" 2>/dev/null || true)" in
            *python*) python3 "$helper" "$@" ;;
            *) bash "$helper" "$@" ;;
        esac
    else
        return 127
    fi
}

SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SCRIPT_REALPATH")/../../.." && pwd)"

resolve_apply_cmd() {
    if [[ -f "${HOME}/.local/bin/apply-shell-state" ]]; then
        printf '%s\n' "${HOME}/.local/bin/apply-shell-state"
        return 0
    fi

    local found=""
    found="$(command -v apply-shell-state 2>/dev/null || true)"
    if [[ -n "$found" ]]; then
        printf '%s\n' "$found"
        return 0
    fi

    if [[ -f "$REPO_ROOT/config/shared/scripts/apply-shell-state" ]]; then
        printf '%s\n' "$REPO_ROOT/config/shared/scripts/apply-shell-state"
        return 0
    fi

    return 1
}

reload_topbar_runtime() {
    # ThemeConfig.qml en MatugenColors.qml pollen de atomair geschreven
    # theme.json/colors.json. Een procesherstart is hier niet alleen overbodig,
    # maar gevaarlijk: een switch kan uit een context zonder WAYLAND_DISPLAY
    # komen, waarna Qt naar xcb terugvalt en alle shell-processen aborteren.
    _log "Quickshell live bijgewerkt via state-polling (geen herstart nodig)"
}

resolve_reader_cmd() {
    if [[ -x "${HOME}/.local/bin/kingstra-theme-read" ]]; then
        printf '%s\n' "${HOME}/.local/bin/kingstra-theme-read"
        return 0
    fi

    local found=""
    found="$(command -v kingstra-theme-read 2>/dev/null || true)"
    if [[ -n "$found" ]]; then
        printf '%s\n' "$found"
        return 0
    fi

    if [[ -f "$REPO_ROOT/config/shared/scripts/kingstra-theme-read.py" ]]; then
        printf '%s\n' "$REPO_ROOT/config/shared/scripts/kingstra-theme-read.py"
        return 0
    fi

    return 1
}

run_reader_cmd() {
    local reader_cmd="$1"
    shift
    if [[ "$reader_cmd" == *.py ]]; then
        python3 "$reader_cmd" "$@"
    else
        "$reader_cmd" "$@"
    fi
}

_notify() {
    notify-send --icon=preferences-desktop-theme \
                --app-name="kingstra" \
                "$1" "${2:-}" \
                --urgency=low \
                --expire-time=3000 \
                2>/dev/null || true
}

_expand_user_path() {
    local path="${1:-}"
    case "$path" in
        "~") printf '%s\n' "$HOME" ;;
        "~/"*) printf '%s\n' "$HOME/${path#\~/}" ;;
        *) printf '%s\n' "$path" ;;
    esac
}

_current_wallpaper_path() {
    local candidate path=""

    for candidate in \
        "$STATE_DIR/wallpaper.json" \
        "$SKWD_CACHE/current_wallpaper" \
        "$SKWD_CACHE/current-wallpaper" \
        "$SKWD_CACHE/last_wallpaper" \
        "$SKWD_CACHE/last-wallpaper" \
        "$SKWD_CACHE/last-wallpaper.json" \
        "$CACHE_DIR/last-wallpaper"; do
        [[ -f "$candidate" ]] || continue

        if [[ "$candidate" == *.json ]]; then
            command -v jq >/dev/null 2>&1 || continue
            path="$(jq -r '.path // .wallpaper // .currentWallpaper // .lastWallpaper // ""' "$candidate" 2>/dev/null || true)"
        else
            path="$(cat "$candidate" 2>/dev/null || true)"
        fi

        path="$(_expand_user_path "$path")"
        if [[ -n "$path" && -f "$path" ]]; then
            printf '%s\n' "$path"
            return 0
        fi
    done

    return 1
}

_is_generated_theme_wallpaper() {
    local file="${1:-}"
    [[ "$file" == "$CACHE_DIR/theme-wallpapers/"* ]]
}

_theme_wallpaper_source() {
    local current="${1:-}"
    local original_file="$CACHE_DIR/theme-wallpaper-source"

    if _is_generated_theme_wallpaper "$current" && [[ -f "$original_file" ]]; then
        cat "$original_file" 2>/dev/null || true
        return 0
    fi

    printf '%s\n' "$current"
}

_write_wallpaper_state() {
    local file="$1"
    [[ -n "$file" && -f "$file" ]] || return 0

    mkdir -p "$CACHE_DIR" "$STATE_DIR" "$SKWD_CACHE"
    printf '%s\n' "$file" > "$CACHE_DIR/last-wallpaper"
    printf '%s\n' "$file" > "$SKWD_CACHE/current_wallpaper"
    printf '%s\n' "$file" > "$SKWD_CACHE/current-wallpaper"
    printf '%s\n' "$file" > "$SKWD_CACHE/last_wallpaper"
    printf '%s\n' "$file" > "$SKWD_CACHE/last-wallpaper"

    if command -v jq >/dev/null 2>&1; then
        jq -n --arg name "$(basename "$file")" --arg path "$file" \
            '{"name":$name,"path":$path}' > "$STATE_DIR/wallpaper.json" 2>/dev/null || true
        jq -n --arg path "$file" --arg type "static" \
            '{"path":$path,"type":$type}' > "$SKWD_CACHE/last-wallpaper.json" 2>/dev/null || true
    fi
}

_path_matches() {
    local left="${1:-}" right="${2:-}"
    [[ -n "$left" && -n "$right" ]] || return 1
    [[ "$(realpath -m "$left" 2>/dev/null || printf '%s' "$left")" == "$(realpath -m "$right" 2>/dev/null || printf '%s' "$right")" ]]
}

_apply_skwd_static_wallpaper() {
    local file="$1"
    [[ -n "$file" && -f "$file" ]] || return 0
    command -v skwd >/dev/null 2>&1 || return 0

    local payload current
    current="$(_current_wallpaper_path || true)"
    _write_wallpaper_state "$file"

    if _path_matches "$current" "$file"; then
        _log "Wallpaper al actief via skwd: $(basename "$file")"
        return 0
    fi

    if command -v jq >/dev/null 2>&1; then
        payload="$(jq -cn --arg name "$(basename "$file")" --arg path "$file" \
            '{name:$name,path:$path,type:"static"}')"
    else
        payload="{\"path\":\"$file\"}"
    fi

    if skwd wall apply "$payload" >/dev/null 2>&1; then
        _log "Wallpaper toegepast via skwd: $(basename "$file")"
    else
        _warn "Kon wallpaper niet toepassen via skwd: $file"
    fi
}

_prepare_theme_wallpaper() {
    local theme_name="$1"
    local current source original_file target_dir target_file target_tmp hash effect_key mono_accent_helper

    current="$(_current_wallpaper_path || true)"
    original_file="$CACHE_DIR/theme-wallpaper-source"

    if [[ "$theme_name" == "mono" || "$theme_name" == "mono-accent" || "$theme_name" == "paper" || "$theme_name" == "neon" ]]; then
        [[ -n "$current" && -f "$current" ]] || return 0

        source="$(_theme_wallpaper_source "$current")"
        if [[ -n "$source" && -f "$source" ]]; then
            printf '%s\n' "$source" > "$original_file"
        else
            source="$current"
            printf '%s\n' "$source" > "$original_file"
        fi
        [[ -n "$source" && -f "$source" ]] || return 0

        if command -v magick >/dev/null 2>&1; then
            case "$theme_name" in
                paper) effect_key="paper-sketch-v6" ;;
                neon)  effect_key="neon-glass-tint-v1" ;;
                mono-accent) effect_key="mono-accent-splash-v1" ;;
                *)     effect_key="mono-gray-v1" ;;
            esac
            hash="$(printf '%s:%s:%s:%s' "$effect_key" "$source" "$(stat -c '%Y' "$source" 2>/dev/null || echo 0)" "$(stat -c '%s' "$source" 2>/dev/null || echo 0)" | sha1sum | awk '{print $1}')"
            target_dir="$CACHE_DIR/theme-wallpapers/$theme_name"
            mkdir -p "$target_dir"
            target_file="$target_dir/${hash}.jpg"
            # Publiceer de cachefile pas als de encoder helemaal klaar is.
            # skwd start zijn decoder zodra het doelpad bestaat; direct naar
            # target_file schrijven liet het daardoor soms een halve JPEG lezen.
            if [[ ! -s "$target_file" ]] || ! magick identify "$target_file" >/dev/null 2>&1; then
                target_tmp="$(mktemp "$target_dir/.${hash}.XXXXXX.jpg")"
                if [[ "$theme_name" == "paper" ]]; then
                    if ! magick "$source" -auto-orient -colorspace Gray \
                        \( +clone -negate -blur 0x18 \) -compose ColorDodge -composite \
                        -blur 0x0.75 -level 12%,98%,0.88 \
                        -colorspace sRGB -type TrueColor \
                        -fill "#c7a16b" -tint 42% \
                        -fill "#f3e0bd" -colorize 12% \
                        -attenuate 0.018 +noise Gaussian \
                        -quality 92 "$target_tmp"; then
                        rm -f "$target_tmp"
                        _warn "Paper-wallpaper kon niet worden gegenereerd"
                        return 0
                    fi
                elif [[ "$theme_name" == "neon" ]]; then
                    if ! magick "$source" -auto-orient -colorspace sRGB \
                        -modulate 100,104,100 \
                        -fill "#00b7ff" -colorize 4% \
                        -fill "#06131d" -colorize 2% \
                        -quality 92 "$target_tmp"; then
                        rm -f "$target_tmp"
                        _warn "Neon-wallpaper kon niet worden gegenereerd"
                        return 0
                    fi
                elif [[ "$theme_name" == "mono-accent" ]]; then
                    mono_accent_helper="${HOME}/.local/bin/kingstra-mono-accent"
                    [[ -f "$mono_accent_helper" ]] || mono_accent_helper="$REPO_ROOT/config/shared/scripts/kingstra-mono-accent"
                    if ! run_helper "$mono_accent_helper" wallpaper "$source" "$target_tmp"; then
                        _warn "Mono Accent color splash mislukt — grijze fallback gebruikt"
                        if ! magick "$source" -auto-orient -colorspace Gray -modulate 100,0,100 -quality 92 "$target_tmp"; then
                            rm -f "$target_tmp"
                            _warn "Mono Accent fallback-wallpaper kon niet worden gegenereerd"
                            return 0
                        fi
                    fi
                else
                    if ! magick "$source" -auto-orient -colorspace Gray -modulate 100,0,100 -quality 92 "$target_tmp"; then
                        rm -f "$target_tmp"
                        _warn "Mono-wallpaper kon niet worden gegenereerd"
                        return 0
                    fi
                fi

                if ! magick identify "$target_tmp" >/dev/null 2>&1; then
                    rm -f "$target_tmp"
                    _warn "Gegenereerde theme-wallpaper is ongeldig"
                    return 0
                fi
                chmod 644 "$target_tmp"
                mv -f "$target_tmp" "$target_file"
            fi
            _apply_skwd_static_wallpaper "$target_file"
        else
            _warn "ImageMagick ontbreekt — theme wallpaper blijft origineel"
        fi
        return 0
    fi

    if [[ -n "$current" ]] && _is_generated_theme_wallpaper "$current" && [[ -f "$original_file" ]]; then
        source="$(cat "$original_file" 2>/dev/null || true)"
        if [[ -n "$source" && -f "$source" ]]; then
            _apply_skwd_static_wallpaper "$source"
        fi
    fi
}

set_ini_value() {
    local file="$1"
    local section="$2"
    local key="$3"
    local value="$4"

    mkdir -p "$(dirname "$file")"
    [[ -f "$file" ]] || printf '[%s]\n' "$section" > "$file"

    python3 - "$file" "$section" "$key" "$value" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
section = sys.argv[2]
key = sys.argv[3]
value = sys.argv[4]

lines = path.read_text(encoding="utf-8").splitlines()
output = []
in_section = False
section_found = False
inserted = False

for line in lines:
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        if in_section and not inserted:
            output.append(f"{key}={value}")
            inserted = True
        in_section = stripped == f"[{section}]"
        section_found = section_found or in_section
        output.append(line)
        continue

    if in_section and stripped.startswith(f"{key}="):
        output.append(f"{key}={value}")
        inserted = True
    else:
        output.append(line)

if not section_found:
    if output and output[-1] != "":
        output.append("")
    output.append(f"[{section}]")
    output.append(f"{key}={value}")
elif in_section and not inserted:
    output.append(f"{key}={value}")

path.write_text("\n".join(output) + "\n", encoding="utf-8")
PY
}

is_true() {
    local value="${1:-false}"
    case "${value,,}" in
        1|true|yes|on) return 0 ;;
        *) return 1 ;;
    esac
}

bool_json() {
    if is_true "${1:-false}"; then
        echo "true"
    else
        echo "false"
    fi
}

canonical_theme_name() {
    case "${1,,}" in
        paper|organic|neon|mono|mono-accent) printf '%s\n' "${1,,}" ;;
        botanical|animated) printf '%s\n' "organic" ;;
        modern|cyber|space|ocean) printf '%s\n' "neon" ;;
        rocky) printf '%s\n' "mono" ;;
        *) printf '%s\n' "" ;;
    esac
}

sync_skwd_config() {
    local scheme_type="$1"
    local mode="$2"
    local theme_name="${3:-}"
    local wallhaven_enabled=true

    if [[ "$theme_name" == "mono" || "$theme_name" == "mono-accent" || "$theme_name" == "paper" || "$theme_name" == "neon" ]]; then
        wallhaven_enabled=false
    fi

    [[ -f "$SKWD_CONFIG" ]] || return 0
    if ! command -v jq &>/dev/null; then
        _warn "jq niet gevonden — skwd-wall config niet gesynchroniseerd"
        return 0
    fi

    local tmp_file
    tmp_file="$(mktemp)"

    if jq \
        --arg scheme "$scheme_type" \
        --arg mode "$mode" \
        --argjson wallhaven_enabled "$wallhaven_enabled" \
        '
        .features.matugen = false
        | .features.wallhaven = $wallhaven_enabled
        | .matugen.schemeType = $scheme
        | .matugen.mode = $mode
        | .postProcessing = (
            [(.postProcessing // [])[] | select((.type // "") != "static")]
            + [{
                "command": "case \"%path%\" in \"$HOME\"/.cache/kingstra/theme-wallpapers/*) ;; *) ~/.local/bin/apply-shell-state --wallpaper \"%path%\" ;; esac; skwd wall unsuppress",
                "type": "static"
              }]
          )
        ' "$SKWD_CONFIG" > "$tmp_file" 2>/dev/null; then
        mv "$tmp_file" "$SKWD_CONFIG"
        _log "skwd-wall config gesynchroniseerd (scheme: $scheme_type, mode: $mode, matugen=false, wallhaven=$wallhaven_enabled)"
    else
        rm -f "$tmp_file"
        _warn "Kon skwd-wall config niet synchroniseren: $SKWD_CONFIG"
    fi
}

pick_enum() {
    local value="$1"
    local default_value="$2"
    local field="$3"
    shift 3
    local allowed
    for allowed in "$@"; do
        if [[ "$value" == "$allowed" ]]; then
            echo "$value"
            return 0
        fi
    done
    _warn "Ongeldige waarde voor $field ('$value'), fallback naar '$default_value'"
    echo "$default_value"
}

sanitize_int() {
    local value="$1"
    local default_value="$2"
    local min_value="$3"
    local max_value="$4"
    local field="$5"

    if [[ ! "$value" =~ ^-?[0-9]+$ ]]; then
        _warn "Ongeldige integer voor $field ('$value'), fallback naar '$default_value'"
        echo "$default_value"
        return 0
    fi

    if (( value < min_value )); then
        echo "$min_value"
    elif (( value > max_value )); then
        echo "$max_value"
    else
        echo "$value"
    fi
}

sanitize_float() {
    local value="$1"
    local default_value="$2"
    local min_value="$3"
    local max_value="$4"
    local field="$5"

    if [[ ! "$value" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
        _warn "Ongeldige float voor $field ('$value'), fallback naar '$default_value'"
        echo "$default_value"
        return 0
    fi

    awk -v v="$value" -v min="$min_value" -v max="$max_value" 'BEGIN {
        if (v < min) v = min;
        if (v > max) v = max;
        print v;
    }'
}

resolve_asset_path() {
    local raw="${1:-}"
    local field="$2"

    if [[ -z "$raw" ]]; then
        echo ""
        return 0
    fi

    local expanded="$raw"
    if [[ "$expanded" == "~/"* ]]; then
        expanded="$HOME/${expanded#~/}"
    fi

    if [[ "$expanded" == /* ]]; then
        if [[ -f "$expanded" ]]; then
            echo "$expanded"
        else
            _warn "Asset niet gevonden voor $field: $expanded"
            echo ""
        fi
        return 0
    fi

    local candidate
    for candidate in "$REPO_ROOT/$expanded" "${XDG_CONFIG_HOME:-$HOME/.config}/$expanded" "$HOME/$expanded"; do
        if [[ -f "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done

    _warn "Asset niet gevonden voor $field: $raw"
    echo ""
}

asset_exists() {
    local raw="${1:-}"
    if [[ -z "$raw" ]]; then
        return 1
    fi

    local expanded="$raw"
    if [[ "$expanded" == "~/"* ]]; then
        expanded="$HOME/${expanded#~/}"
    fi

    if [[ "$expanded" == /* ]]; then
        [[ -f "$expanded" ]]
        return $?
    fi

    local candidate
    for candidate in "$REPO_ROOT/$expanded" "${XDG_CONFIG_HOME:-$HOME/.config}/$expanded" "$HOME/$expanded"; do
        if [[ -f "$candidate" ]]; then
            return 0
        fi
    done
    return 1
}

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------
if [[ "${1:-}" == "--current" ]]; then
    current_theme="$(cat "$ACTIVE_FILE" 2>/dev/null || true)"
    canonical_theme="$(canonical_theme_name "$current_theme")"
    echo "${canonical_theme:-$DEFAULT_THEME}"
    exit 0
fi

if [[ "${1:-}" == "--list" ]]; then
    READER_CMD="$(resolve_reader_cmd || true)"
    if [[ -z "$READER_CMD" ]]; then
        _warn "kingstra-theme-read niet gevonden"
        echo "[]"
        exit 1
    fi
    run_reader_cmd "$READER_CMD" --list "$THEMES_DIR"
    exit 0
fi

REQUESTED_THEME="${1:?Gebruik: kingstra-theme-switch <theme_naam>}"
THEME_NAME="$(canonical_theme_name "$REQUESTED_THEME")"
if [[ -z "$THEME_NAME" ]]; then
    _warn "Onbekend thema: $REQUESTED_THEME (beschikbaar: paper, organic, neon, mono, mono-accent)"
    exit 1
fi
if [[ "$THEME_NAME" != "${REQUESTED_THEME,,}" ]]; then
    _warn "Legacy-thema '$REQUESTED_THEME' gemigreerd naar '$THEME_NAME'"
fi
THEME_FILE="$THEMES_DIR/${THEME_NAME}.toml"

if [[ ! -f "$THEME_FILE" ]]; then
    _warn "Thema niet gevonden: $THEME_FILE"
    exit 1
fi

_log "Overschakelen naar thema: $THEME_NAME"

READER_CMD="$(resolve_reader_cmd || true)"
if [[ -z "$READER_CMD" ]]; then
    _warn "kingstra-theme-read niet gevonden — thema niet toepasbaar"
    exit 1
fi

# ---------------------------------------------------------------------------
# Read theme values via Python helper
# ---------------------------------------------------------------------------
READER_OUTPUT="$(run_reader_cmd "$READER_CMD" "$THEME_FILE" 2>/dev/null || true)"
if [[ -z "$READER_OUTPUT" ]]; then
    _warn "Kon themawaarden niet lezen uit: $THEME_FILE"
    exit 1
fi
eval "$READER_OUTPUT"

# Variables are now available as: META_NAME, MATUGEN_SCHEME_TYPE, APPEARANCE_BORDER_RADIUS, etc.
MATUGEN_SCHEME_JSON=$(pick_enum "${MATUGEN_SCHEME_TYPE:-scheme-tonal-spot}" "scheme-tonal-spot" "matugen.scheme_type" \
    scheme-content scheme-expressive scheme-fidelity scheme-fruit-salad scheme-monochrome scheme-neutral scheme-rainbow scheme-tonal-spot)
MATUGEN_MODE_JSON=$(pick_enum "${MATUGEN_MODE:-dark}" "dark" "matugen.mode" \
    dark light)

BAR_SHAPE_JSON=$(pick_enum "${BAR_SHAPE:-rounded}" "rounded" "bar.shape" \
    rounded organic-grown capsule block segmented-capsule beveled kinetic-dock)
BAR_POSITION_JSON=$(pick_enum "${QUICKSHELL_BAR_POSITION:-top}" "top" "quickshell.bar_position" \
    top bottom left right)
BAR_TEMPLATE_JSON=$(pick_enum "${BAR_TEMPLATE:-auto}" "auto" "bar.template" \
    auto horizontal sidebar compact-sidebar)
if [[ -n "${BAR_TOPBAR_LOOSE_BLOCKS+x}" ]]; then
    BAR_TOPBAR_LOOSE_BLOCKS_JSON=$(bool_json "${BAR_TOPBAR_LOOSE_BLOCKS}")
fi
BAR_WIDTH_MODE_JSON=$(pick_enum "${BAR_WIDTH_MODE:-full}" "full" "bar.width_mode" \
    full floating)
BAR_FLOATING_JSON=$(bool_json "${BAR_FLOATING:-false}")
BAR_ATTACH_TO_SCREEN_EDGE_JSON=$(bool_json "${BAR_ATTACH_TO_SCREEN_EDGE:-true}")
BAR_TOP_EDGE_STYLE_JSON=$(pick_enum "${BAR_TOP_EDGE_STYLE:-soft}" "soft" "bar.top_edge_style" \
    flush soft hard beveled)
BAR_BOTTOM_EDGE_STYLE_JSON=$(pick_enum "${BAR_BOTTOM_EDGE_STYLE:-soft}" "soft" "bar.bottom_edge_style" \
    flush soft hard beveled ornate-rounded)
CLOCK_STYLE_JSON=$(pick_enum "${BAR_CLOCK_STYLE:-digital}" "digital" "bar.clock_style" \
    digital analog hybrid)
if [[ -n "${QUICKSHELL_BAR_RAIL_ENABLED+x}" ]]; then
    BAR_RAIL_ENABLED_JSON=$(bool_json "${QUICKSHELL_BAR_RAIL_ENABLED}")
else
    BAR_RAIL_ENABLED_JSON=$(bool_json "$([[ "$BAR_POSITION_JSON" == "left" || "$BAR_POSITION_JSON" == "right" ]] && echo true || echo false)")
fi
BAR_RAIL_EDGE_JSON=$(pick_enum "${QUICKSHELL_BAR_RAIL_EDGE:-left}" "left" "quickshell.bar_rail_edge" top bottom left right)
BAR_RAIL_WIDTH_JSON=$(sanitize_int "${QUICKSHELL_BAR_RAIL_WIDTH:-52}" "52" "44" "96" "quickshell.bar_rail_width")
if [[ -n "${QUICKSHELL_BAR_STATUS_STRIP_ENABLED+x}" ]]; then
    BAR_STATUS_STRIP_ENABLED_JSON=$(bool_json "${QUICKSHELL_BAR_STATUS_STRIP_ENABLED}")
else
    BAR_STATUS_STRIP_ENABLED_JSON=$(bool_json "$([[ "$BAR_POSITION_JSON" == "top" || "$BAR_POSITION_JSON" == "bottom" ]] && echo true || echo false)")
fi
BAR_STATUS_STRIP_EDGE_JSON=$(pick_enum "${QUICKSHELL_BAR_STATUS_STRIP_EDGE:-$BAR_POSITION_JSON}" "$BAR_POSITION_JSON" "quickshell.bar_status_strip_edge" top bottom left right)
BAR_STATUS_STRIP_HEIGHT_JSON=$(sanitize_int "${QUICKSHELL_BAR_STATUS_STRIP_HEIGHT:-${QUICKSHELL_BAR_HEIGHT:-36}}" "36" "30" "96" "quickshell.bar_status_strip_height")

TOPBAR_LOOSE_BLOCKS_LINE=""
if [[ -n "${BAR_TOPBAR_LOOSE_BLOCKS+x}" ]]; then
    TOPBAR_LOOSE_BLOCKS_LINE="    \"topbar_loose_blocks\": ${BAR_TOPBAR_LOOSE_BLOCKS_JSON},"
fi

WIDGET_SHAPE_JSON="${WIDGETS_SHAPE:-rounded}"
WIDGET_SURFACE_JSON="${WIDGETS_SURFACE:-standard}"

PARTICLE_TYPE_JSON=$(pick_enum "${EFFECTS_PARTICLES:-none}" "none" "effects.particles" \
    none fireflies space-specks space-specks-layered sparkles rain snow dust)
PARTICLE_COUNT_JSON=$(sanitize_int "${EFFECTS_PARTICLE_COUNT:-0}" "0" "0" "50" "effects.particle_count")
PARTICLE_SPEED_JSON=$(sanitize_float "${EFFECTS_PARTICLE_SPEED:-0.0}" "0.0" "0.0" "2.0" "effects.particle_speed")
AMBIENT_EFFECT_JSON=$(pick_enum "${EFFECTS_AMBIENT_EFFECT:-theme-default}" "theme-default" "effects.ambient_effect" \
    theme-default none organic-glow neon-grid cyber-grid)
EFFECT_INTENSITY_JSON=$(sanitize_float "${EFFECTS_EFFECT_INTENSITY:-1.0}" "1.0" "0.0" "2.0" "effects.effect_intensity")
EFFECT_CYCLE_MS_JSON=$(sanitize_int "${EFFECTS_EFFECT_CYCLE_MS:-0}" "0" "0" "30000" "effects.effect_cycle_ms")
EFFECT_HOVER_REACTIVITY_JSON=$(sanitize_float "${EFFECTS_HOVER_REACTIVITY:-0.4}" "0.4" "0.0" "1.0" "effects.hover_reactivity")

DRAWER_STYLE_JSON=$(pick_enum "${BAR_DYNAMICS_DRAWER_STYLE:-context-card}" "context-card" "bar_dynamics.drawer_style" \
    none context-card rail-panel)
MODULE_DENSITY_JSON=$(pick_enum "${BAR_DYNAMICS_MODULE_DENSITY:-balanced}" "balanced" "bar_dynamics.module_density" \
    minimal balanced rich)
WORKSPACE_PREVIEW_JSON=$(pick_enum "${BAR_DYNAMICS_WORKSPACE_PREVIEW:-hybrid}" "hybrid" "bar_dynamics.workspace_preview" \
    numbers app-icons hybrid)
RAIL_ACCENT_JSON=$(pick_enum "${BAR_DYNAMICS_RAIL_ACCENT:-none}" "none" "bar_dynamics.rail_accent" \
    none edge-line pulse-line segmented)

TERMINAL_OVERLAY_ASSET_JSON=$(resolve_asset_path "${TERMINAL_VISUAL_OVERLAY_ASSET:-}" "terminal_visual.overlay_asset")
TERMINAL_OVERLAY_OPACITY_JSON=$(sanitize_float "${TERMINAL_VISUAL_OVERLAY_OPACITY:-0.0}" "0.0" "0.0" "1.0" "terminal_visual.overlay_opacity")
TEXTURE_OVERLAY_ASSET_JSON=""
if [[ -n "${MATERIAL_TEXTURE_ASSET:-}" ]]; then
    TEXTURE_OVERLAY_ASSET_JSON=$(resolve_asset_path "${MATERIAL_TEXTURE_ASSET}" "material.texture_asset")
else
    DEFAULT_TEXTURE_REL="assets/themes/${THEME_NAME}/texture-overlay.png"
    if asset_exists "$DEFAULT_TEXTURE_REL"; then
        TEXTURE_OVERLAY_ASSET_JSON=$(resolve_asset_path "$DEFAULT_TEXTURE_REL" "material.texture_asset")
    fi
fi

# ---------------------------------------------------------------------------
# Theme style profiles — one coherent visual language per theme
# ---------------------------------------------------------------------------
STYLE_FAMILY="organic"
STYLE_DENSITY="comfortable"
STYLE_SURFACE_MODE="soft-glass"
STYLE_MOTION="gentle"
STYLE_PANEL_SHADOW=0.22
STYLE_OUTLINE_STRENGTH=0.18
STYLE_GLASS_STRENGTH=0.10
STYLE_WIDGET_RADIUS=${APPEARANCE_BORDER_RADIUS:-12}
STYLE_PANEL_PADDING=14

case "$THEME_NAME" in
    organic)
        STYLE_FAMILY="organic"
        STYLE_DENSITY="comfortable"
        STYLE_SURFACE_MODE="soft-glass"
        STYLE_MOTION="gentle"
        STYLE_PANEL_SHADOW=0.22
        STYLE_OUTLINE_STRENGTH=0.18
        STYLE_GLASS_STRENGTH=0.10
        STYLE_WIDGET_RADIUS=20
        STYLE_PANEL_PADDING=15
        ;;
    neon)
        STYLE_FAMILY="neon"
        STYLE_DENSITY="compact"
        STYLE_SURFACE_MODE="hard-surface"
        STYLE_MOTION="snappy"
        STYLE_PANEL_SHADOW=0.42
        STYLE_OUTLINE_STRENGTH=0.58
        STYLE_GLASS_STRENGTH=0.02
        STYLE_WIDGET_RADIUS=5
        STYLE_PANEL_PADDING=9
        ;;
    mono|mono-accent)
        STYLE_FAMILY="mono"
        STYLE_DENSITY="compact"
        STYLE_SURFACE_MODE="solid"
        STYLE_MOTION="firm"
        STYLE_PANEL_SHADOW=0.02
        STYLE_OUTLINE_STRENGTH=0.42
        STYLE_GLASS_STRENGTH=0.0
        STYLE_WIDGET_RADIUS=0
        STYLE_PANEL_PADDING=7
        ;;
    paper)
        STYLE_FAMILY="paper"
        STYLE_DENSITY="comfortable"
        STYLE_SURFACE_MODE="paper-glass"
        STYLE_MOTION="calm"
        STYLE_PANEL_SHADOW=0.04
        STYLE_OUTLINE_STRENGTH=0.10
        STYLE_GLASS_STRENGTH=0.02
        STYLE_WIDGET_RADIUS=10
        STYLE_PANEL_PADDING=16
        ;;
esac

STYLE_FAMILY=$(pick_enum "${STYLE_PROFILE_FAMILY:-$STYLE_FAMILY}" "$STYLE_FAMILY" "style_profile.family" \
    paper organic neon mono mono-accent)
STYLE_DENSITY=$(pick_enum "${STYLE_PROFILE_DENSITY:-$STYLE_DENSITY}" "$STYLE_DENSITY" "style_profile.density" \
    compact comfortable airy)
STYLE_SURFACE_MODE=$(pick_enum "${STYLE_PROFILE_SURFACE_MODE:-$STYLE_SURFACE_MODE}" "$STYLE_SURFACE_MODE" "style_profile.surface_mode" \
    paper-glass soft-glass hard-surface solid)
STYLE_MOTION=$(pick_enum "${STYLE_PROFILE_MOTION:-$STYLE_MOTION}" "$STYLE_MOTION" "style_profile.motion" \
    calm gentle snappy firm)
STYLE_PANEL_SHADOW=$(sanitize_float "${STYLE_PROFILE_PANEL_SHADOW:-$STYLE_PANEL_SHADOW}" "$STYLE_PANEL_SHADOW" "0.0" "0.5" "style_profile.panel_shadow")
STYLE_OUTLINE_STRENGTH=$(sanitize_float "${STYLE_PROFILE_OUTLINE_STRENGTH:-$STYLE_OUTLINE_STRENGTH}" "$STYLE_OUTLINE_STRENGTH" "0.0" "0.5" "style_profile.outline_strength")
STYLE_GLASS_STRENGTH=$(sanitize_float "${STYLE_PROFILE_GLASS_STRENGTH:-$STYLE_GLASS_STRENGTH}" "$STYLE_GLASS_STRENGTH" "0.0" "0.5" "style_profile.glass_strength")
STYLE_WIDGET_RADIUS=$(sanitize_int "${STYLE_PROFILE_WIDGET_RADIUS:-$STYLE_WIDGET_RADIUS}" "$STYLE_WIDGET_RADIUS" "0" "48" "style_profile.widget_radius")
STYLE_PANEL_PADDING=$(sanitize_int "${STYLE_PROFILE_PANEL_PADDING:-$STYLE_PANEL_PADDING}" "$STYLE_PANEL_PADDING" "6" "28" "style_profile.panel_padding")

SCREEN_SHADER="[[EMPTY]]"
if [[ "$THEME_NAME" == "mono" ]]; then
    MONO_SCREEN_SHADER="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/shaders/mono-grayscale.glsl"
    if [[ -f "$MONO_SCREEN_SHADER" ]]; then
        SCREEN_SHADER="$MONO_SCREEN_SHADER"
    else
        _warn "Mono grayscale-shader niet gevonden: $MONO_SCREEN_SHADER"
    fi
fi

# ---------------------------------------------------------------------------
# Step 1 — Update matugen config.toml (scheme_type + color_index)
# ---------------------------------------------------------------------------
if [[ -f "$MATUGEN_CONF" ]]; then
    sed -i "s|^scheme_type\s*=.*|scheme_type = \"${MATUGEN_SCHEME_JSON}\"|" "$MATUGEN_CONF"
    sed -i "s|^color_index\s*=.*|color_index = ${MATUGEN_COLOR_INDEX:-0}|" "$MATUGEN_CONF"
    sed -i "s|^mode\s*=.*|mode = \"${MATUGEN_MODE_JSON}\"|" "$MATUGEN_CONF"
    _log "Matugen config bijgewerkt (scheme: ${MATUGEN_SCHEME_JSON}, mode: ${MATUGEN_MODE_JSON})"
fi
sync_skwd_config "${MATUGEN_SCHEME_JSON}" "${MATUGEN_MODE_JSON}" "$THEME_NAME"

# Paper/Mono hebben een theme-specifieke wallpaper-variant. Doe dit vóór de rest
# van de theme-generatie, zodat je niet eerst nog naar de onbewerkte foto kijkt.
_prepare_theme_wallpaper "$THEME_NAME"

# ---------------------------------------------------------------------------
# Step 2 — Generate 35-theme.conf (Hyprland overrides)
# ---------------------------------------------------------------------------
mkdir -p "$(dirname "$THEME_CONF")"
THEME_CONF_TMP="$(mktemp "${THEME_CONF}.XXXXXX")"
if ! cat > "$THEME_CONF_TMP" <<EOF
# =============================================================================
# 35-theme.conf — Automatisch gegenereerd door kingstra-theme-switch
# Thema: ${META_NAME:-$THEME_NAME}
# =============================================================================

general {
    gaps_in = ${APPEARANCE_GAPS_IN:-5}
    gaps_out = ${APPEARANCE_GAPS_OUT:-10}
    border_size = ${APPEARANCE_BORDER_WIDTH:-2}
}

decoration {
    rounding = ${APPEARANCE_BORDER_RADIUS:-12}
    screen_shader = ${SCREEN_SHADER}
    blur {
        size = ${APPEARANCE_BLUR_SIZE:-8}
        passes = ${APPEARANCE_BLUR_PASSES:-3}
    }
}
EOF
then
    rm -f -- "$THEME_CONF_TMP"
    _warn "35-theme.conf genereren mislukt"
    exit 1
fi
chmod 0644 "$THEME_CONF_TMP"
mv -f -- "$THEME_CONF_TMP" "$THEME_CONF"
_log "35-theme.conf gegenereerd"

# ---------------------------------------------------------------------------
# Step 3 — Generate theme.json (QuickShell via FileView)
# ---------------------------------------------------------------------------
mkdir -p "$(dirname "$THEME_JSON")"
THEME_JSON_TMP="$(mktemp "${THEME_JSON}.XXXXXX")"
trap 'rm -f "${THEME_JSON_TMP:-}"' EXIT
