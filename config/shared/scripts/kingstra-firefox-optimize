#!/usr/bin/env bash
# =============================================================================
# kingstra-firefox-optimize — Apply managed Firefox performance prefs to profiles
# =============================================================================
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
PROFILE_ROOT="${HOME}/.mozilla/firefox"
PROFILES_INI="${PROFILE_ROOT}/profiles.ini"
TEMPLATE_FILE="${CONFIG_HOME}/firefox/user.js"
CHROME_TEMPLATE_FILE="${CONFIG_HOME}/firefox/chrome/userChrome.css"
CONTENT_TEMPLATE_FILE="${CONFIG_HOME}/firefox/chrome/userContent.css"
MATUGEN_FIREFOX_COLORS="${CONFIG_HOME}/matugen/generated/firefox_websites.css"
# Vorm en letter van het thema (kingstra-apps-sync schrijft dit bij elke wissel).
KINGSTRA_FIREFOX_SHAPE="${XDG_STATE_HOME:-$HOME/.local/state}/kingstra/apps/firefox-shape.css"
START_MARKER='// >>> kingstra performance profile >>>'
END_MARKER='// <<< kingstra performance profile <<<'
CHROME_START_MARKER='/* >>> kingstra firefox chrome >>> */'
CHROME_END_MARKER='/* <<< kingstra firefox chrome <<< */'

log() {
    printf '[kingstra-firefox-optimize] %s\n' "$*"
}

resolve_profile_path() {
    local is_relative="$1"
    local raw_path="$2"

    if [[ "$is_relative" == "1" ]]; then
        printf '%s\n' "${PROFILE_ROOT}/${raw_path}"
    else
        printf '%s\n' "$raw_path"
    fi
}

apply_template_to_profile() {
    local profile_dir="$1"
    local user_js="${profile_dir}/user.js"
    local tmp_file

    mkdir -p "$profile_dir"

    if [[ ! -f "$user_js" ]]; then
        cp "$TEMPLATE_FILE" "$user_js"
        log "nieuw user.js geplaatst in $(basename "$profile_dir")"
        return 0
    fi

    tmp_file="$(mktemp)"
    awk -v start="$START_MARKER" -v end="$END_MARKER" '
        BEGIN { skip = 0 }
        $0 == start { skip = 1; next }
        $0 == end { skip = 0; next }
        !skip { print }
    ' "$user_js" > "$tmp_file"

    {
        cat "$tmp_file"
        [[ -s "$tmp_file" ]] && printf '\n'
        cat "$TEMPLATE_FILE"
    } > "${tmp_file}.merged"

    mv "${tmp_file}.merged" "$user_js"
    rm -f "$tmp_file"
    log "managed prefs bijgewerkt in $(basename "$profile_dir")"
}

# Zet een beheerd blok (kleuren + vormlaag + template) bovenaan een
# chrome-bestand; eigen regels van de gebruiker eronder blijven staan.
apply_css_to_profile() {
    local profile_dir="$1"
    local template="$2"
    local name="$3"
    local chrome_dir="${profile_dir}/chrome"
    local target="${chrome_dir}/${name}"
    local tmp_file

    [[ -f "$template" ]] || {
        log "chrome-template ontbreekt: $template"
        return 0
    }

    mkdir -p "$chrome_dir"
    tmp_file="$(mktemp)"

    if [[ -f "$target" ]]; then
        awk -v start="$CHROME_START_MARKER" -v end="$CHROME_END_MARKER" '
            BEGIN { skip = 0 }
            $0 == start { skip = 1; next }
            $0 == end { skip = 0; next }
            !skip { print }
        ' "$target" > "$tmp_file"
    fi

    {
        printf '%s\n' "$CHROME_START_MARKER"
        printf '@import url("file://%s");\n' "$MATUGEN_FIREFOX_COLORS"
        printf '@import url("file://%s");\n\n' "$KINGSTRA_FIREFOX_SHAPE"
        cat "$template"
        printf '%s\n' "$CHROME_END_MARKER"
        [[ -s "$tmp_file" ]] && printf '\n'
        cat "$tmp_file"
    } > "${tmp_file}.merged"

    mv "${tmp_file}.merged" "$target"
    rm -f "$tmp_file"
    log "managed ${name} bijgewerkt in $(basename "$profile_dir")"
}

# Pdf's opslaan in plaats van in Firefox openen (handlers.json action 0 =
# opslaan; 3 = in Firefox). Firefox schrijft dit bestand zelf bij afsluiten,
# dus het werkt pas zeker na een herstart van Firefox; pdfjs.disabled in
# user.js vangt het ook op als Firefox open stond.
apply_pdf_handler_to_profile() {
    local handlers="$1/handlers.json"
    [[ -f "$handlers" ]] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    python3 - "$handlers" <<'PY' && log "pdf's opslaan in plaats van openen in $(basename "$1")"
import json, sys, os, tempfile
path = sys.argv[1]
try:
    data = json.load(open(path))
except Exception:
    sys.exit(1)
pdf = data.setdefault("mimeTypes", {}).setdefault("application/pdf", {})
if pdf.get("action") == 0 and pdf.get("ask") is not True:
    sys.exit(1)
pdf["action"] = 0
pdf.pop("ask", None)
pdf.setdefault("extensions", ["pdf"])
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(data, f)
os.replace(tmp, path)
PY
    return 0
}

apply_chrome_to_profile() {
    apply_css_to_profile "$1" "$CHROME_TEMPLATE_FILE" userChrome.css
    apply_css_to_profile "$1" "$CONTENT_TEMPLATE_FILE" userContent.css
}

main() {
    local current_path=""
    local current_relative="1"
    local applied=0

    [[ -f "$TEMPLATE_FILE" ]] || {
        log "template ontbreekt: $TEMPLATE_FILE"
        exit 1
    }

    [[ -f "$PROFILES_INI" ]] || {
        log "geen Firefox-profielen gevonden"
        exit 0
    }

    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            \[*\])
                if [[ -n "$current_path" ]]; then
                    local profile_dir
                    profile_dir="$(resolve_profile_path "$current_relative" "$current_path")"
                    apply_template_to_profile "$profile_dir"
                    apply_chrome_to_profile "$profile_dir"
                    apply_pdf_handler_to_profile "$profile_dir"
                    applied=$((applied + 1))
                fi
                current_path=""
                current_relative="1"
                ;;
            Path=*)
                current_path="${line#Path=}"
                ;;
            IsRelative=*)
                current_relative="${line#IsRelative=}"
                ;;
        esac
    done < "$PROFILES_INI"

    if [[ -n "$current_path" ]]; then
        local profile_dir
        profile_dir="$(resolve_profile_path "$current_relative" "$current_path")"
        apply_template_to_profile "$profile_dir"
        apply_chrome_to_profile "$profile_dir"
        apply_pdf_handler_to_profile "$profile_dir"
        applied=$((applied + 1))
    fi

    log "klaar (${applied} profielen)"
}

main "$@"
