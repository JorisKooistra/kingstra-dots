#!/usr/bin/env bash
# =============================================================================
# kingstra-rollback — Dotfiles terug naar een eerder terugzetpunt
# =============================================================================
# Gebruik:
#   kingstra-rollback                 terug naar het laatste terugzetpunt
#   kingstra-rollback <tag>           terug naar een bepaald terugzetpunt
#   kingstra-rollback --list          terugzetpunten tonen
#   kingstra-rollback --release       weer meegaan met updates
#   kingstra-rollback --dry-run [..]  laten zien wat er zou gebeuren
#   kingstra-rollback --system [bestand]  pakketten van de laatste update
#                                     terug naar de vorige versie
#   kingstra-rollback --system --list  updates die terug kunnen
#
# Na een rollback staan de dotfiles "vast": de updater haalt geen nieuwe
# dotfiles op tot je --release draait. --system zet pakketten terug uit de
# pakketcache, volgens de transactie die kingstra update heeft vastgelegd.
# =============================================================================
set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kingstra"
SNAP_LOG="$STATE_DIR/snapshots.log"
HOLD_FILE="$STATE_DIR/update-hold"
TAG_PREFIX="kingstra/pre-update-"
DRY_RUN=false

_say()  { printf '%s\n' "$*"; }
_die()  { printf 'Fout: %s\n' "$*" >&2; exit 1; }

resolve_repo() {
    local marker="${XDG_DATA_HOME:-$HOME/.local/share}/kingstra/install-complete"
    local repo="" self=""
    [[ -n "${KINGSTRA_REPO:-}" ]] && repo="$KINGSTRA_REPO"
    if [[ -z "$repo" && -f "$marker" ]]; then
        repo="$(sed -n 's/^Repo:[[:space:]]*//p' "$marker" | head -n 1)"
    fi
    if [[ -z "$repo" ]]; then
        self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
        [[ -n "$self" ]] && repo="$(cd "$(dirname "$self")/../../.." 2>/dev/null && pwd -P || true)"
    fi
    [[ -n "$repo" && -d "$repo/.git" ]] || return 1
    printf '%s\n' "$repo"
}

TX_DIR="$STATE_DIR/updates/transacties"
YAY_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/yay"
PKG_CACHE="${KINGSTRA_PKG_CACHE:-/var/cache/pacman/pkg}"

# Het pakketbestand van een oude versie: eerst de pacman-cache, dan die van yay.
cached_pkg() {
    local name="$1" ver="$2" f
    for f in "$PKG_CACHE/$name-$ver"-*.pkg.tar.* "$YAY_CACHE/$name/$name-$ver"-*.pkg.tar.*; do
        [[ -f "$f" && "$f" != *.sig ]] || continue
        # name-ver-arch.pkg.tar.*: zorg dat "foo" niet "foo-bar" vangt.
        [[ "$(basename "$f")" =~ ^"$name"-"$ver"-[^-]+\.pkg\.tar ]] || continue
        printf '%s\n' "$f"
        return 0
    done
    return 1
}

system_list() {
    local f up inst
    if ! compgen -G "$TX_DIR/*.tsv" >/dev/null; then
        _say "Nog geen vastgelegde updates. Die komen er bij elke kingstra update bij."
        return 0
    fi
    _say "Updates die terug kunnen (nieuwste eerst):"
    while IFS= read -r f; do
        up="$(grep -c '^upgraded' "$f" || true)"
        inst="$(grep -c '^installed' "$f" || true)"
        printf '  %s  %s bijgewerkt, %s nieuw  (%s)\n' \
            "$(date -r "$f" '+%Y-%m-%d %H:%M')" "$up" "$inst" "$f"
    done < <(ls -1t "$TX_DIR"/*.tsv)
}

# Pakketten van één update terugzetten naar de versie van daarvoor.
system_rollback() {
    local tx="${1:-}" action name old _new pkg reply
    local -a files=() missing=() added=()
    if [[ -z "$tx" ]]; then
        tx="$(ls -1t "$TX_DIR"/*.tsv 2>/dev/null | head -n 1)"
        [[ -n "$tx" ]] || _die "geen vastgelegde update gevonden (kingstra update legt ze vast)."
    fi
    [[ -f "$tx" ]] || _die "bestand niet gevonden: $tx"

    while IFS=$'\t' read -r action name old _new; do
        case "$action" in
            upgraded|downgraded|removed)
                [[ -n "$old" ]] || continue
                if pkg="$(cached_pkg "$name" "$old")"; then
                    files+=("$pkg")
                else
                    missing+=("$name $old")
                fi ;;
            installed) added+=("$name") ;;
        esac
    done < "$tx"

    _say "Update van $(date -r "$tx" '+%Y-%m-%d %H:%M') terugdraaien:"
    _say "  ${#files[@]} pakket(ten) terug naar de vorige versie"
    (( ${#missing[@]} > 0 )) && _say "  ${#missing[@]} niet meer in de cache (blijven nieuw): ${missing[*]:0:8}"
    (( ${#added[@]} > 0 )) && _say "  ${#added[@]} nieuw geïnstalleerd (blijven staan): ${added[*]:0:8}"
    if (( ${#files[@]} == 0 )); then
        _say "Er valt niets terug te zetten."
        return 0
    fi
    if $DRY_RUN; then
        printf '  %s\n' "${files[@]}"
        _say "Dry-run: er is niets gewijzigd."
        return 0
    fi
    if ! $ASSUME_YES; then
        read -r -p "Doorgaan? [j/N] " reply || reply=""
        [[ "$reply" =~ ^[jJyY] ]] || { _say "Niets gewijzigd."; return 0; }
    fi
    # Geen --noconfirm: pacman toont zelf nog wat er gebeurt en vraagt akkoord.
    sudo pacman -U --needed -- "${files[@]}" || _die "pacman meldde een fout; zie hierboven."
    mkdir -p "$STATE_DIR"
    printf '%s|%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$tx" >> "$STATE_DIR/system-rollbacks.log"
    _say ""
    _say "Klaar. Herstart als er een kernel of driver bij zat."
    _say "Let op: de volgende kingstra update zet deze pakketten weer op de nieuwe versie."
}

snapper_for_tag() {
    local tag="$1"
    [[ -f "$SNAP_LOG" ]] || return 0
    awk -F'|' -v t="$tag" '$2 == t && $4 != "-" { n = $4 } END { if (n != "") print n }' "$SNAP_LOG"
}

args=()
SYSTEM=false
ASSUME_YES=false
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        --system|systeem) SYSTEM=true ;;
        --yes|-y) ASSUME_YES=true ;;
        *) args+=("$arg") ;;
    esac
done
set -- "${args[@]+"${args[@]}"}"

if $SYSTEM; then
    case "${1:-}" in
        --list|list) system_list ;;
        *) system_rollback "${1:-}" ;;
    esac
    exit $?
fi

REPO="$(resolve_repo)" || _die "geen kingstra-dots git-repo gevonden."

case "${1:-}" in
    --list|list)
        tags="$(git -C "$REPO" tag --list "${TAG_PREFIX}*" --sort=-refname)"
        if [[ -z "$tags" ]]; then
            _say "Nog geen terugzetpunten. Die komen er bij elke update vanzelf bij."
            exit 0
        fi
        while IFS= read -r t; do
            printf '%s  %s\n' "$t" "$(git -C "$REPO" log -1 --format='%h %s' "$t")"
        done <<< "$tags"
        [[ -f "$HOLD_FILE" ]] && _say "" "Dotfiles staan nu vast op: $(cat "$HOLD_FILE")"
        exit 0
        ;;
    --release|release)
        if [[ -f "$HOLD_FILE" ]]; then
            $DRY_RUN || rm -f "$HOLD_FILE"
            _say "Dotfiles gaan weer mee met updates. Draai de updater om bij te werken."
        else
            _say "Dotfiles stonden niet vast."
        fi
        exit 0
        ;;
    -h|--help|help)
        sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

TARGET="${1:-}"
if [[ -z "$TARGET" ]]; then
    TARGET="$(git -C "$REPO" tag --list "${TAG_PREFIX}*" --sort=-refname | head -n 1)"
    [[ -n "$TARGET" ]] || _die "geen terugzetpunt gevonden (kingstra-rollback --list)."
fi
git -C "$REPO" rev-parse --verify --quiet "$TARGET^{commit}" >/dev/null || _die "onbekend terugzetpunt: $TARGET"

if [[ -n "$(git -C "$REPO" status --porcelain --untracked-files=no)" ]]; then
    git -C "$REPO" status --short --untracked-files=no
    _die "er staan lokale wijzigingen in $REPO; commit of stash ze eerst."
fi

current="$(git -C "$REPO" rev-parse --short HEAD)"
target_short="$(git -C "$REPO" rev-parse --short "$TARGET^{commit}")"
_say "Dotfiles: $current -> $target_short ($TARGET)"

if $DRY_RUN; then
    _say "Dry-run: er is niets gewijzigd."
    exit 0
fi

# Eerst de huidige stand vastleggen, zodat ook de rollback terug te draaien is.
git -C "$REPO" tag "kingstra/pre-rollback-$(date +%Y%m%d-%H%M%S)" HEAD >/dev/null 2>&1 || true

git -C "$REPO" reset --keep "$TARGET" || _die "terugzetten mislukt; er is niets gewijzigd."
mkdir -p "$STATE_DIR"
printf '%s\n' "$TARGET" > "$HOLD_FILE"

if [[ -x "$REPO/install.sh" || -f "$REPO/install.sh" ]]; then
    _say "Installer draaien om de oude stand toe te passen..."
    bash "$REPO/install.sh" --yes || _say "De installer meldde een fout; zie de log in ~/.local/share/kingstra."
fi

snap="$(snapper_for_tag "$TARGET")"
_say ""
_say "Klaar. De dotfiles staan vast op $TARGET; de updater laat ze met rust."
_say "Weer meegaan met updates: kingstra-rollback --release"
if [[ -n "$snap" ]]; then
    _say ""
    _say "Bij dit terugzetpunt hoort ook snapper-snapshot #$snap van het systeem."
    _say "Systeempakketten terugzetten kan via het bootmenu (grub-btrfs of limine)"
    _say "of met: sudo snapper -c root undochange $snap..0"
fi
