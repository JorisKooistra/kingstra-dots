#!/usr/bin/env bash
# =============================================================================
# kingstra-matugen-run — Run Matugen from active Kingstra theme contract
# =============================================================================
# Gebruik:
#   kingstra-matugen-run --wallpaper <bestand> [extra matugen args]
#   kingstra-matugen-run [extra matugen args]          # gebruikt huidige wallpaper
#   kingstra-matugen-run --resolved-json               # toon resolved inputs en stop
# Voorbeelden:
#   kingstra-matugen-run --wallpaper ~/Pictures/wall.png
#   kingstra-matugen-run --wallpaper ~/Pictures/wall.png --json hex
# =============================================================================
set -euo pipefail

THEME_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/theme.json"
MATUGEN_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/matugen/config.toml"
THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/themes"
ACTIVE_THEME_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/active-theme"
STATE_THEME_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/state/theme.json"
STATE_WALLPAPER_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/state/wallpaper.json"
SESSION_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/kingstra/state/session.json"
CACHE_WALLPAPER="${XDG_CACHE_HOME:-$HOME/.cache}/kingstra/last-wallpaper"
MATUGEN_STAGE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/kingstra/matugen-stage"
HYPR_COLORS_TARGET="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/colors.conf"
QUICKSHELL_COLORS_TARGET="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/colors.json"

DEFAULT_SCHEME="scheme-tonal-spot"
DEFAULT_MODE="dark"
DEFAULT_COLOR_INDEX="0"
DEFAULT_THEME="organic"

WALLPAPER=""
THEME_OVERRIDE=""
PRINT_RESOLVED_JSON=false
EXTRA_ARGS=()

_warn() { echo "[kingstra-matugen-run] WARN: $*" >&2; }
_die()  { echo "[kingstra-matugen-run] FOUT: $*" >&2; exit 1; }

SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SCRIPT_REALPATH")/../../.." && pwd)"

_run_helper() {
    local helper="$1"
    shift

    if [[ -x "$helper" ]]; then
        "$helper" "$@"
    elif [[ -f "$helper" ]]; then
        python3 "$helper" "$@"
    else
        return 127
    fi
}

_atomic_publish() {
    local source="$1"
    local target="$2"
    local validator="${3:-nonempty}"
    local target_dir=""
    local target_tmp=""

    target_dir="$(dirname "$target")"
    mkdir -p "$target_dir"

    case "$validator" in
        json)
            command -v jq >/dev/null 2>&1 || _die "jq ontbreekt voor JSON-validatie"
            jq -e 'type == "object"' "$source" >/dev/null 2>&1 \
                || _die "Matugen leverde ongeldige Quickshell-JSON: $source"
            ;;
        hypr)
            [[ -s "$source" ]] || _die "Matugen leverde lege Hyprland-kleuren"
            if grep -Eq '\{\{|\}\}' "$source"; then
                _die "Onverwerkte Matugen-tokens in Hyprland-kleuren"
            fi
            ;;
        nonempty)
            [[ -s "$source" ]] || _die "Matugen leverde lege output: $source"
            ;;
    esac

    target_tmp="$(mktemp "$target_dir/.kingstra-matugen.XXXXXX")"
    if ! cp -- "$source" "$target_tmp"; then
        rm -f -- "$target_tmp"
        _die "Kon Matugen-output niet klaarzetten voor $target"
    fi
    chmod 0644 "$target_tmp"

    # Geen inode-wissel en dus geen onnodige watcher/reload als de inhoud gelijk
    # bleef (bijvoorbeeld bij twee snelle apply-runs voor dezelfde wallpaper).
    if [[ -f "$target" ]] && cmp -s -- "$target_tmp" "$target"; then
        rm -f -- "$target_tmp"
        return 0
    fi

    mv -f -- "$target_tmp" "$target"
}

_publish_runtime_outputs() {
    local staged_hypr="$MATUGEN_STAGE_DIR/hypr-colors.conf"
    local staged_quickshell="$MATUGEN_STAGE_DIR/quickshell-colors.json"

    _atomic_publish "$staged_hypr" "$HYPR_COLORS_TARGET" hypr
    _atomic_publish "$staged_quickshell" "$QUICKSHELL_COLORS_TARGET" json
}

_mono_accent_helper() {
    if [[ -f "${HOME}/.local/bin/kingstra-mono-accent" ]]; then
        printf '%s\n' "${HOME}/.local/bin/kingstra-mono-accent"
    else
        printf '%s\n' "$REPO_ROOT/config/shared/scripts/kingstra-mono-accent"
    fi
}

_usage() {
    cat <<'EOF'
Gebruik:
  kingstra-matugen-run --wallpaper <bestand> [extra matugen args]
  kingstra-matugen-run [extra matugen args]
  kingstra-matugen-run --resolved-json
EOF
}

_set_toml_value() {
    local file="$1"
    local key="$2"
    local value="$3"
    mkdir -p "$(dirname "$file")"
    [[ -f "$file" ]] || touch "$file"
    if grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "$file"; then
        sed -i -E "s|^[[:space:]]*${key}[[:space:]]*=.*|${key} = ${value}|" "$file"
    else
        printf '%s = %s\n' "$key" "$value" >> "$file"
    fi
}

_set_template_output_path() {
    local file="$1"
    local template="$2"
    local output_path="$3"
    local escaped_path=""

    # config.toml is gegenereerde user-state en kan al bestaan uit een eerdere
    # installatie. Forceer de twee live outputs daarom bij iedere contract-run
    # naar staging, zonder te leunen op een niet-getrackte lokale config.
    escaped_path="${output_path//|/\\|}"
    sed -i -E \
        "/^[[:space:]]*\\[templates\\.${template}\\][[:space:]]*$/,/^[[:space:]]*\\[/ s|^[[:space:]]*output_path[[:space:]]*=.*|output_path = \"${escaped_path}\"|" \
        "$file"
}

_valid_mode() {
    case "${1:-}" in
        dark|light) return 0 ;;
        *) return 1 ;;
    esac
}

_valid_scheme() {
    case "${1:-}" in
        scheme-content|scheme-expressive|scheme-fidelity|scheme-fruit-salad|scheme-monochrome|scheme-neutral|scheme-rainbow|scheme-tonal-spot)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

_canonical_theme_name() {
    case "${1,,}" in
        paper|organic|neon|mono|mono-accent) printf '%s\n' "${1,,}" ;;
        botanical|animated) printf '%s\n' "organic" ;;
        modern|cyber|space|ocean) printf '%s\n' "neon" ;;
        rocky) printf '%s\n' "mono" ;;
        *) printf '%s\n' "" ;;
    esac
}

_resolve_theme_id() {
    local theme_id=""

    if [[ -n "$THEME_OVERRIDE" ]]; then
        theme_id="$THEME_OVERRIDE"
    fi

    if [[ -z "$theme_id" && -f "$THEME_JSON" ]] && command -v jq &>/dev/null; then
        theme_id="$(jq -r '.theme // ""' "$THEME_JSON" 2>/dev/null || echo "")"
    fi

    if [[ -z "$theme_id" && -f "$ACTIVE_THEME_FILE" ]]; then
        theme_id="$(cat "$ACTIVE_THEME_FILE" 2>/dev/null || echo "")"
    fi

    if [[ -z "$theme_id" && -f "$STATE_THEME_FILE" ]] && command -v jq &>/dev/null; then
        theme_id="$(jq -r '.name // ""' "$STATE_THEME_FILE" 2>/dev/null || echo "")"
    fi

    if [[ -z "$theme_id" ]]; then
        theme_id="$DEFAULT_THEME"
    fi

    local canonical_theme
    canonical_theme="$(_canonical_theme_name "$theme_id")"
    if [[ -z "$canonical_theme" ]]; then
        _warn "Theme '${theme_id}' onbekend, fallback naar '${DEFAULT_THEME}'"
        echo "$DEFAULT_THEME"
    else
        echo "$canonical_theme"
    fi
}

_resolve_theme_file() {
    local theme_id="$1"
    local theme_file="$THEMES_DIR/${theme_id}.toml"
    if [[ -f "$theme_file" ]]; then
        printf '%s|%s\n' "$theme_id" "$theme_file"
        return 0
    fi

    local fallback_file="$THEMES_DIR/${DEFAULT_THEME}.toml"
    if [[ -f "$fallback_file" ]]; then
        _warn "Theme '${theme_id}' niet gevonden, fallback naar '${DEFAULT_THEME}'"
        printf '%s|%s\n' "$DEFAULT_THEME" "$fallback_file"
        return 0
    fi

    _warn "Geen theme TOML gevonden in $THEMES_DIR, defaults gebruikt"
    printf '%s|\n' "$DEFAULT_THEME"
}

_read_theme_matugen() {
    local theme_file="$1"
    local default_scheme="$2"
    local default_mode="$3"
    local default_index="$4"

    if [[ -z "$theme_file" || ! -f "$theme_file" ]]; then
        printf '%s|%s|%s\n' "$default_scheme" "$default_mode" "$default_index"
        return 0
    fi

    python3 - "$theme_file" "$default_scheme" "$default_mode" "$default_index" <<'PY'
import sys
from pathlib import Path
try:
    import tomllib
except Exception:
    import tomli as tomllib

theme_file = Path(sys.argv[1])
default_scheme = sys.argv[2]
default_mode = sys.argv[3]
default_index = sys.argv[4]

scheme = default_scheme
mode = default_mode
index = default_index

try:
    data = tomllib.loads(theme_file.read_text(encoding="utf-8"))
    matugen = data.get("matugen", {}) if isinstance(data, dict) else {}
    if isinstance(matugen, dict):
        v = matugen.get("scheme_type")
        if isinstance(v, str) and v.strip():
            scheme = v.strip()
        v = matugen.get("mode")
        if isinstance(v, str) and v.strip():
            mode = v.strip()
        v = matugen.get("color_index")
        if isinstance(v, int):
            index = str(v)
        elif isinstance(v, str) and v.strip():
            index = v.strip()
except Exception:
    pass

print(f"{scheme}|{mode}|{index}")
PY
}

_expand_user_path() {
    local raw="${1:-}"
    if [[ "$raw" == "~/"* ]]; then
        printf '%s\n' "$HOME/${raw#~/}"
    else
        printf '%s\n' "$raw"
    fi
}

_resolve_wallpaper() {
    # Bewust géén daemon-query meer: skwd is de enige renderer en de
    # state-bestanden hieronder zijn leidend. De oude `awww query`-stap gaf
    # een verouderde wallpaper terug zolang awww-daemon nog ergens draaide.
    local candidate="$WALLPAPER"

    if [[ -n "$candidate" && -f "$candidate" ]]; then
        echo "$candidate"
        return 0
    fi

    if [[ -n "$candidate" && ! -f "$candidate" ]]; then
        _warn "Meegegeven wallpaper bestaat niet: $candidate"
        candidate=""
    fi

    if [[ -f "$STATE_WALLPAPER_FILE" ]] && command -v jq &>/dev/null; then
        candidate="$(jq -r '.path // ""' "$STATE_WALLPAPER_FILE" 2>/dev/null || echo "")"
        candidate="$(_expand_user_path "$candidate")"
        if [[ -n "$candidate" && -f "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    fi

    if [[ -f "$SESSION_FILE" ]] && command -v jq &>/dev/null; then
        candidate="$(jq -r '.wallpaper // ""' "$SESSION_FILE" 2>/dev/null || echo "")"
        candidate="$(_expand_user_path "$candidate")"
        if [[ -n "$candidate" && -f "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    fi

    for skwd_cache in \
        "${XDG_CACHE_HOME:-$HOME/.cache}/skwd-wall/current_wallpaper" \
        "${XDG_CACHE_HOME:-$HOME/.cache}/skwd-wall/current-wallpaper" \
        "${XDG_CACHE_HOME:-$HOME/.cache}/skwd-wall/last_wallpaper" \
        "${XDG_CACHE_HOME:-$HOME/.cache}/skwd-wall/last-wallpaper"; do
        [[ -f "$skwd_cache" ]] || continue
        candidate="$(cat "$skwd_cache" 2>/dev/null || echo "")"
        candidate="$(_expand_user_path "$candidate")"
        if [[ -n "$candidate" && -f "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done

    for skwd_json in \
        "${XDG_CACHE_HOME:-$HOME/.cache}/skwd-wall/last-wallpaper.json" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/skwd-wall/state.json"; do
        [[ -f "$skwd_json" ]] || continue
        if command -v jq >/dev/null 2>&1; then
            candidate="$(jq -r '.path // .wallpaper // .currentWallpaper // .lastWallpaper // ""' "$skwd_json" 2>/dev/null || echo "")"
            candidate="$(_expand_user_path "$candidate")"
            if [[ -n "$candidate" && -f "$candidate" ]]; then
                echo "$candidate"
                return 0
            fi
        fi
    done

    if [[ -f "$CACHE_WALLPAPER" ]]; then
        candidate="$(cat "$CACHE_WALLPAPER" 2>/dev/null || echo "")"
        candidate="$(_expand_user_path "$candidate")"
        if [[ -n "$candidate" && -f "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    fi

    echo ""
}

_emit_resolved_json() {
    local theme_id="$1"
    local theme_file="$2"
    local wallpaper="$3"
    local scheme="$4"
    local mode="$5"
    local color_index="$6"

    python3 - "$theme_id" "$theme_file" "$wallpaper" "$scheme" "$mode" "$color_index" <<'PY'
import json, sys
theme_id, theme_file, wallpaper, scheme, mode, color_index = sys.argv[1:7]
try:
    idx = int(color_index)
except Exception:
    idx = 0
print(json.dumps({
    "theme": theme_id,
    "theme_file": theme_file,
    "wallpaper": wallpaper,
    "scheme_type": scheme,
    "mode": mode,
    "color_index": idx,
}))
PY
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --wallpaper|-w)
            shift
            [[ $# -gt 0 ]] || _die "Optie --wallpaper verwacht een pad"
            WALLPAPER="$1"
            shift
            ;;
        --theme|-t)
            shift
            [[ $# -gt 0 ]] || _die "Optie --theme verwacht een naam"
            THEME_OVERRIDE="$1"
            shift
            ;;
        --resolved-json)
            PRINT_RESOLVED_JSON=true
            shift
            ;;
        --help|-h)
            _usage
            exit 0
            ;;
        --)
            shift
            EXTRA_ARGS+=("$@")
            break
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

THEME_ID="$(_resolve_theme_id)"
THEME_RESOLVED="$(_resolve_theme_file "$THEME_ID")"
THEME_ID="${THEME_RESOLVED%%|*}"
THEME_FILE="${THEME_RESOLVED#*|}"
THEME_SETTINGS="$(_read_theme_matugen "$THEME_FILE" "$DEFAULT_SCHEME" "$DEFAULT_MODE" "$DEFAULT_COLOR_INDEX")"
SCHEME_TYPE="${THEME_SETTINGS%%|*}"
MODE_AND_INDEX="${THEME_SETTINGS#*|}"
MODE="${MODE_AND_INDEX%%|*}"
COLOR_INDEX="${MODE_AND_INDEX#*|}"

WALLPAPER="$(_resolve_wallpaper)"

if [[ -z "$SCHEME_TYPE" ]] || ! _valid_scheme "$SCHEME_TYPE"; then
    _warn "Ongeldige scheme_type '$SCHEME_TYPE', fallback naar $DEFAULT_SCHEME"
    SCHEME_TYPE="$DEFAULT_SCHEME"
fi

if ! _valid_mode "$MODE"; then
    _warn "Ongeldige mode '$MODE', fallback naar $DEFAULT_MODE"
    MODE="$DEFAULT_MODE"
fi

if [[ ! "$COLOR_INDEX" =~ ^-?[0-9]+$ ]]; then
    _warn "Ongeldige color_index '$COLOR_INDEX', fallback naar $DEFAULT_COLOR_INDEX"
    COLOR_INDEX="$DEFAULT_COLOR_INDEX"
fi

if (( COLOR_INDEX < 0 )); then
    COLOR_INDEX=0
fi

if $PRINT_RESOLVED_JSON; then
    _emit_resolved_json "$THEME_ID" "$THEME_FILE" "$WALLPAPER" "$SCHEME_TYPE" "$MODE" "$COLOR_INDEX"
    exit 0
fi

command -v matugen &>/dev/null || _die "matugen niet gevonden in PATH"
if [[ -z "$WALLPAPER" || ! -f "$WALLPAPER" ]]; then
    _die "Geen geldig wallpaperbestand gevonden"
fi
mkdir -p "$MATUGEN_STAGE_DIR"

# Houd matugen/config.toml gelijk aan actieve theme-contract settings.
_set_toml_value "$MATUGEN_CONF" "scheme_type" "\"$SCHEME_TYPE\""
_set_toml_value "$MATUGEN_CONF" "mode" "\"$MODE\""
_set_toml_value "$MATUGEN_CONF" "color_index" "$COLOR_INDEX"
_set_template_output_path "$MATUGEN_CONF" "hyprland" "$MATUGEN_STAGE_DIR/hypr-colors.conf"
_set_template_output_path "$MATUGEN_CONF" "quickshell" "$MATUGEN_STAGE_DIR/quickshell-colors.json"

# Haal een kleine, bruikbare set echte wallpaper-kleuren op. Matugen maakt een
# goed Material-palet, maar primary/secondary/tertiary blijven scheme-afgeleiden
# van een enkele seed. Voor chrome en app-accenten willen we daarnaast 2 extra
# kleuren die echt in de afbeelding zitten.
#
# Twee histogrammen, bewust met verschillende korrel:
#   - grof (192x192, 48 kleuren) bepaalt de seed. Dit is de bestaande
#     kwantisatie; primary blijft daardoor identiek aan wat een theme al
#     opleverde, ook na deze wijziging.
#   - fijn (512x512, 128 kleuren) bepaalt accent 2 en 3. Op de grove korrel
#     smelten kleine, felle vlakken (neonreclame, lampen, signalering) weg in
#     het dominante achtergrondvlak, waardoor er buiten de seed-tintfamilie
#     vrijwel niets overbleef om uit te kiezen.
_extract_wallpaper_palette() {
    local image="$1"
    local index="$2"
    local magick_bin=""

    if command -v magick &>/dev/null; then
        magick_bin="magick"
    elif command -v convert &>/dev/null; then
        magick_bin="convert"
    else
        return 1
    fi

    python3 - "$magick_bin" "$image" "$index" <<'PY'
import colorsys
import math
import re
import subprocess
import sys

magick_bin, image, raw_index = sys.argv[1:4]
try:
    color_index = max(0, int(raw_index))
except Exception:
    color_index = 0


def histogram(resize, ncolors):
    out = subprocess.check_output(
        [
            magick_bin,
            image,
            "-resize",
            resize,
            "-colors",
            str(ncolors),
            "-depth",
            "8",
            "-format",
            "%c",
            "histogram:info:-",
        ],
        stderr=subprocess.DEVNULL,
        text=True,
    )
    counts = {}
    for line in out.splitlines():
        count_match = re.match(r"\s*(\d+):", line)
        hex_match = re.search(r"#([0-9A-Fa-f]{6})", line)
        if not count_match or not hex_match:
            continue
        hexc = "#" + hex_match.group(1).upper()
        counts[hexc] = counts.get(hexc, 0) + int(count_match.group(1))
    return counts


def analyse(counts):
    total = sum(counts.values()) or 1
    out = []
    for hexc, count in counts.items():
        r, g, b = (int(hexc[i : i + 2], 16) for i in (1, 3, 5))
        mx, mn = max(r, g, b), min(r, g, b)
        h, l, s = colorsys.rgb_to_hls(r / 255.0, g / 255.0, b / 255.0)
        chroma = mx - mn
        balance = max(0.25, 1.0 - abs(l - 0.48) * 1.15)
        score = math.log(count + 1.0) * (0.45 + s) * (0.60 + chroma / 255.0) * balance
        out.append(
            {
                "hex": hexc,
                "count": count,
                "rgb": (r, g, b),
                "h": h,
                "l": l,
                "s": s,
                "chroma": chroma,
                "score": score,
                "share": count / total,
            }
        )
    return sorted(out, key=lambda c: (-c["score"], -c["count"]))


def hue_delta(a, b):
    d = abs(a - b) % 1.0
    return min(d, 1.0 - d)


try:
    coarse = analyse(histogram("192x192!", 48))
except Exception:
    sys.exit(1)

if not coarse:
    sys.exit(1)

seed_pool = [
    c
    for c in coarse
    if c["chroma"] >= 16 and max(c["rgb"]) >= 36 and 0.07 <= c["l"] <= 0.92
] or coarse
seed = seed_pool[color_index] if color_index < len(seed_pool) else seed_pool[0]

try:
    fine = analyse(histogram("512x512!", 128))
except Exception:
    fine = coarse
if not fine:
    fine = coarse

MAX_ROT = 15.0 / 360.0


def harmonized(h, source_h):
    """Voorspel de tint die matugen van deze bron zal maken.

    Custom colors staan hier op blend=true, waardoor matugen Material's
    Blend.harmonize toepast: de tint draait tot 15 graden naar de bronkleur toe.
    De scheiding moet daarom op de uitkomst worden gemeten, niet op de bron —
    anders levert een bron die net ver genoeg lijkt alsnog een accent op dat
    tegen de primary aan kruipt.
    """
    rot = min(hue_delta(h, source_h) * 0.5, MAX_ROT)
    direction = 1.0 if ((source_h - h) % 1.0) <= 0.5 else -1.0
    return (h + direction * rot) % 1.0


# Kwaliteitspoorten voor accentkandidaten, van streng naar soepel. Chroma is
# leidend en oppervlak nadrukkelijk niet: een accent moet kleur hebben, ook als
# het maar een paar procent van het beeld beslaat. De laatste poort is een
# vangnet dat ook vrijwel kleurloze kandidaten toelaat en alleen meedoet als er
# in de andere poorten niet eens twee kandidaten zitten.
TIERS = [
    {"chroma": 90, "s": 0.40, "lmin": 0.24, "lmax": 0.78, "share": 0.00060},
    {"chroma": 64, "s": 0.32, "lmin": 0.20, "lmax": 0.82, "share": 0.00040},
    {"chroma": 46, "s": 0.24, "lmin": 0.17, "lmax": 0.86, "share": 0.00020},
    {"chroma": 30, "s": 0.16, "lmin": 0.13, "lmax": 0.90, "share": 0.00010},
    {"chroma": 14, "s": 0.00, "lmin": 0.06, "lmax": 0.94, "share": 0.00000},
]
SEP_TARGET = 0.105  # ~38 graden; daarboven telt extra scheiding niet meer mee


def gated(pool, tier):
    return [
        c
        for c in pool
        if c["chroma"] >= tier["chroma"]
        and c["s"] >= tier["s"]
        and tier["lmin"] <= c["l"] <= tier["lmax"]
        and c["share"] >= tier["share"]
        and max(c["rgb"]) >= 48
    ]


def best_pair(candidates, source_h):
    """Kies beide accenten in één keer, op de krapste tintafstand.

    Accent 2 en 3 los na elkaar kiezen loopt vast: de tweede keuze verwerpt dan
    een sterke kleur omdat die te dicht bij de eerste ligt, en wijkt uit naar een
    zwakke kleur die toevallig ver weg ligt. Door het paar als geheel te wegen
    wint de combinatie die primary, accent 2 en accent 3 het verst uit elkaar
    zet, met prominentie als tiebreak.

    Meet zowel de echte brontinten als de voorspelde geharmoniseerde tinten.
    Alleen die laatste meten gaf rond de 0/360-grens een vals positief: twee
    vrijwel gelijke rode bronnen aan weerszijden van de grens konden bij een
    bijna tegengestelde seed elk een andere kant op draaien en daardoor uniek
    lijken. Matugen hield ze in de uiteindelijke Material-tonen alsnog allebei
    rood.
    """
    out = None
    for i, a in enumerate(candidates):
        for b in candidates[i + 1 :]:
            source_spread = min(
                hue_delta(a["h"], source_h),
                hue_delta(b["h"], source_h),
                hue_delta(a["h"], b["h"]),
            )
            harmonized_spread = min(
                hue_delta(a["_eh"], source_h),
                hue_delta(b["_eh"], source_h),
                hue_delta(a["_eh"], b["_eh"]),
            )
            spread = min(source_spread, harmonized_spread)
            key = (min(spread / SEP_TARGET, 1.0), a["score"] * b["score"])
            if out is None or key > out[0]:
                out = (key, (a, b))
    return out


seed_hue = seed["h"]
accent_pool = [c for c in fine if c["hex"] != seed["hex"]]
for c in accent_pool:
    c["_eh"] = harmonized(c["h"], seed_hue)

# Kwaliteit is een harde ondergrens: een bron met te weinig chroma levert na
# matugen geen herkenbare kleur op, hoe mooi de tintspreiding ook uitpakt.
# Binnen de bruikbare poorten wint de beste spreiding; bij gelijke spreiding
# houdt de strengste poort het.
chosen = None
for tier in TIERS[:-1]:
    candidates = gated(accent_pool, tier)
    if len(candidates) < 2:
        continue
    tier_best = best_pair(candidates, seed_hue)
    if tier_best is None:
        continue
    if chosen is None or tier_best[0][0] > chosen[0][0] + 1e-9:
        chosen = tier_best
if chosen is None:
    candidates = gated(accent_pool, TIERS[-1])
    if len(candidates) >= 2:
        chosen = best_pair(candidates, seed_hue)

if chosen is None:
    picked = [seed, seed, seed]
else:
    a2, a3 = chosen[1]
    if a3["score"] > a2["score"]:
        a2, a3 = a3, a2
    picked = [seed, a2, a3]

for c in picked[:3]:
    print(c["hex"])
PY
}

# Injecteert/vervangt een [config.custom_colors]-blok in matugen/config.toml.
# Waarom: matugen leidt primary/secondary/tertiary allemaal wiskundig af van
# ÉÉN seed-kleur (hue-rotatie binnen het gekozen scheme_type). Een wallpaper
# met twee losstaande dominante tinten (bv. blauw water + groen gebergte)
# versmelt daardoor tot één tintfamilie, vooral bij terughoudende schemes
# als scheme-content. Een custom color met blend=true voegt een echte
# tweede, uit de foto bemonsterde tint toe — licht richting het schema
# geharmoniseerd, zonder de eigen hue kwijt te raken. Idempotent: verwijdert
# een eerder ingevoegd blok voordat het een vers blok aan het bestand toevoegt.
_set_custom_colors_block() {
    local file="$1"
    shift
    local begin_marker="# BEGIN kingstra-custom-colors"
    local end_marker="# END kingstra-custom-colors"

    if grep -qF "$begin_marker" "$file" 2>/dev/null; then
        sed -i "/^${begin_marker}\$/,/^${end_marker}\$/d" "$file"
    fi

    # De sed hierboven haalt het blok weg maar laat de scheidingsregel staan die
    # er bij het schrijven voor is gezet. Zonder deze opschoning groeit
    # config.toml bij elke themawissel met een lege regel.
    printf '%s\n' "$(sed -e :a -e '/^\s*$/{$d;N;ba' -e '}' "$file")" > "$file"

    {
        echo ""
        echo "$begin_marker"
        echo "[config.custom_colors]"
        printf '%s\n' "$@"
        echo "$end_marker"
    } >> "$file"
}

mapfile -t WALLPAPER_PALETTE < <(_extract_wallpaper_palette "$WALLPAPER" "$COLOR_INDEX" || true)
PALETTE_SEED_HEX="${WALLPAPER_PALETTE[0]:-}"
SECONDARY_HEX="${WALLPAPER_PALETTE[1]:-}"
TERTIARY_HEX="${WALLPAPER_PALETTE[2]:-}"

SOURCE_HEX=""
if (( COLOR_INDEX > 0 )) || [[ "$THEME_ID" == "mono-accent" ]]; then
    SOURCE_HEX="$PALETTE_SEED_HEX"
    if [[ ! "$SOURCE_HEX" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
        _warn "Kon dominante kleur #$COLOR_INDEX niet bepalen — fallback naar image-modus"
        SOURCE_HEX=""
    fi
fi

if [[ ! "$SECONDARY_HEX" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    SECONDARY_HEX="${SOURCE_HEX:-#7f849c}"
fi
if [[ ! "$TERTIARY_HEX" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    TERTIARY_HEX="$SECONDARY_HEX"
fi
SECONDARY_BLEND=true
if [[ "$THEME_ID" == "mono" || "$THEME_ID" == "mono-accent" ]]; then
    SECONDARY_BLEND=false
fi
if [[ "$THEME_ID" == "mono-accent" && "$SOURCE_HEX" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    SECONDARY_HEX="$SOURCE_HEX"
    TERTIARY_HEX="$SOURCE_HEX"
fi
_set_custom_colors_block "$MATUGEN_CONF" \
    "secondary_accent = { color = \"${SECONDARY_HEX}\", blend = ${SECONDARY_BLEND} }" \
    "tertiary_accent = { color = \"${TERTIARY_HEX}\", blend = ${SECONDARY_BLEND} }"

if [[ -n "$SOURCE_HEX" ]]; then
    MATUGEN_ARGS=(
        color hex "$SOURCE_HEX"
        --type "$SCHEME_TYPE"
        --mode "$MODE"
    )
else
    MATUGEN_ARGS=(
        image "$WALLPAPER"
        --type "$SCHEME_TYPE"
        --mode "$MODE"
        --source-color-index "$COLOR_INDEX"
    )
fi

if [[ -f "$MATUGEN_CONF" ]]; then
    MATUGEN_ARGS+=(--config "$MATUGEN_CONF")
fi

MATUGEN_BASE_ARGS=("${MATUGEN_ARGS[@]}")
MATUGEN_ARGS+=("${EXTRA_ARGS[@]}")

if [[ "$THEME_ID" == "mono-accent" ]]; then
    JSON_REQUESTED=false
    for arg in "${EXTRA_ARGS[@]}"; do
        case "$arg" in
            --json|-j|--json=*) JSON_REQUESTED=true ;;
        esac
    done

    RAW_PALETTE="$(matugen "${MATUGEN_BASE_ARGS[@]}" --dry-run --json hex)"
    ACTUAL_OUTPUT="$(matugen "${MATUGEN_ARGS[@]}")"
    MONO_ACCENT_HELPER="$(_mono_accent_helper)"

    if TRANSFORMED_PALETTE="$(printf '%s\n' "$RAW_PALETTE" | _run_helper "$MONO_ACCENT_HELPER" palette --config "$MATUGEN_CONF" --mode "$MODE")"; then
        if $JSON_REQUESTED; then
            printf '%s\n' "$TRANSFORMED_PALETTE"
        elif [[ -n "$ACTUAL_OUTPUT" ]]; then
            printf '%s\n' "$ACTUAL_OUTPUT"
        fi
    else
        _warn "Mono Accent palette-normalisatie mislukt — onbewerkte Matugen-output behouden"
        [[ -z "$ACTUAL_OUTPUT" ]] || printf '%s\n' "$ACTUAL_OUTPUT"
    fi
else
    matugen "${MATUGEN_ARGS[@]}"
fi

# Hyprland en Quickshell bewaken hun runtimebestanden live. Matugen schrijft
# outputs met truncate/write; publiceer daarom pas na een geslaagde volledige
# run en validatie, via een tijdelijke file op hetzelfde filesystem.
_publish_runtime_outputs
