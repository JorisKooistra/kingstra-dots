#!/usr/bin/env python3
"""Demp Matugen-kleuren voor Matte, inclusief alle gegenereerde app-themes.

De tinten blijven uit de wallpaper komen. Alleen de lichtheid en verzadiging
veranderen: rustige houtskoolvlakken, gebroken witte tekst en stoffige accenten.
"""
import argparse
import colorsys
import copy
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import re
import sys


def tone(value, role):
    if not isinstance(value, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        return value
    rgb = [int(value[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    h, light, sat = colorsys.rgb_to_hls(*rgb)
    if role in {"on_background", "on_surface", "inverse_surface"}:
        light, sat = min(light, .79), min(sat, .10)
    elif role in {"background", "surface", "surface_dim", "surface_bright", "surface_variant"} or role.startswith("surface_container"):
        light, sat = max(light, .085), min(sat, .12)
    elif role in {"primary", "secondary", "tertiary", "secondary_accent", "tertiary_accent"}:
        light, sat = .61, min(sat, .34)
    elif role.endswith("_source"):
        light, sat = min(.61, max(.32, light)), min(sat, .34)
    elif "container" in role and not role.startswith("on_"):
        sat = min(sat, .20)
    else:
        return value
    return "#" + "".join(f"{round(c * 255):02x}" for c in colorsys.hls_to_rgb(h, light, sat))


def contrast(a, b):
    def luminance(value):
        rgb = [int(value[i:i + 2], 16) / 255 for i in (1, 3, 5)]
        rgb = [v / 12.92 if v <= .04045 else ((v + .055) / 1.055) ** 2.4 for v in rgb]
        return sum(v * w for v, w in zip(rgb, (.2126, .7152, .0722)))
    x, y = sorted((luminance(a), luminance(b)))
    return (y + .05) / (x + .05)


def transform(palette, mode):
    result = copy.deepcopy(palette)
    roles = result.get("colors", {}).get(mode, {})
    for role, value in roles.items():
        roles[role] = tone(value, role)
    # De knoppen behouden hun on_*-tekst. Borg het contrast na het dempen,
    # ook voor blauwe/paarse wallpapers die bij gelijke lichtheid donkerder ogen.
    for role in ("primary", "secondary", "tertiary", "secondary_accent", "tertiary_accent"):
        if role not in roles or "on_" + role not in roles:
            continue
        foreground = roles["on_" + role]
        rgb = [int(roles[role][i:i + 2], 16) / 255 for i in (1, 3, 5)]
        h, light, sat = colorsys.rgb_to_hls(*rgb)
        step = .01 if mode == "dark" else -.01
        while contrast(roles[role], foreground) < 4.5 and .08 < light < .90:
            light += step
            roles[role] = "#" + "".join(f"{round(c * 255):02x}" for c in colorsys.hls_to_rgb(h, light, sat))
    return result


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", type=Path, required=True)
    parser.add_argument("--mode", choices=["dark", "light"], default="dark")
    args = parser.parse_args()
    raw = json.load(sys.stdin)
    # Gebruik dezelfde veilige outputpublicatie als de bestaande accenthelper.
    path = Path(__file__).resolve().with_name("kingstra-mono-accent")
    loader = importlib.machinery.SourceFileLoader("kingstra_palette_io", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    io = importlib.util.module_from_spec(spec)
    loader.exec_module(io)
    result = transform(raw, args.mode)
    mapping = io._replacement_map(raw, result, args.mode)
    for output in io._output_paths(args.config):
        io._rewrite_output(output, mapping)
    json.dump(result, sys.stdout)


if __name__ == "__main__":
    main()
