#!/usr/bin/env bash
# =============================================================================
# kingstra — Eén commando voor alles van kingstra-dots
# =============================================================================
# De losse kingstra-*-scripts blijven bestaan; dit is alleen een ingang met
# korte, Nederlandse subcommando's. Zie: kingstra help
# =============================================================================
set -uo pipefail

BIN="$HOME/.local/bin"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
QS_MANAGER="$CONFIG_HOME/hypr/scripts/qs_manager.sh"

resolve_repo() {
    local marker="${XDG_DATA_HOME:-$HOME/.local/share}/kingstra/install-complete" repo="" self=""
    [[ -n "${KINGSTRA_REPO:-}" ]] && repo="$KINGSTRA_REPO"
    if [[ -z "$repo" && -f "$marker" ]]; then
        repo="$(sed -n 's/^Repo:[[:space:]]*//p' "$marker" | head -n 1)"
    fi
    if [[ -z "$repo" ]]; then
        self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
        [[ -n "$self" ]] && repo="$(cd "$(dirname "$self")/../../.." 2>/dev/null && pwd -P || true)"
    fi
    [[ -n "$repo" && -d "$repo" ]] || return 1
    printf '%s\n' "$repo"
}

run() {
    local cmd="$1"; shift
    if [[ -x "$BIN/$cmd" ]]; then
        exec "$BIN/$cmd" "$@"
    elif command -v "$cmd" >/dev/null 2>&1; then
        exec "$cmd" "$@"
    fi
    printf 'kingstra: %s niet gevonden; draai install.sh --yes\n' "$cmd" >&2
    exit 127
}

panel() {
    [[ -x "$QS_MANAGER" ]] || { echo "kingstra: qs_manager.sh niet gevonden" >&2; exit 127; }
    exec "$QS_MANAGER" toggle "$1"
}

usage() {
    cat <<'TXT'
Gebruik: kingstra <commando> [opties]

Uiterlijk
  theme [naam|--list]      thema wisselen of tonen (zonder naam: kiezer)
  mode [office|gaming|media]  modus wisselen (zonder naam: kiezer)
  wallpaper <set|random|pick|...>  achtergrond (zie kingstra wallpaper --help)

Onderhoud
  update                   alles bijwerken (systeem, Flatpak, dotfiles)
  doctor                   installatie controleren, met hersteladvies
  snapshot [list|create]   terugzetpunten tonen of maken
  rollback [--list|--release|<tag>]  dotfiles terug naar een terugzetpunt
  refresh <onderdeel>      één config terug naar de standaard (bv. kitty)
  restart                  shell herstarten (bar, panelen, overzicht)
  install [opties]         installer draaien (zie install.sh --help)

Openen
  bediening                centraal paneel voor schermmode, rail en werkvlak
  settings [pagina]        instellingen, optioneel op een pagina (thema, geluid, sessie, ...)
  keys | launcher | quick  sneltoetsen, launcher, controlecentrum
  menu                     toetsenbordmenu voor alles (Super+Alt+Spatie)
  widgets aan|uit|klok <plek>  bureaubladklok en media (plek: linksboven, rechtsboven, midden, linksonder, rechtsonder)
  eiland [osd|meldingen|live] aan|uit  wat het eiland onder de balk toont
  indeling [naam|scroll|kies]  indeling van deze werkruimte (tegels, 50-50, 70-30, midden, kolommen, scrollen, focus)
  kladblok [stuur]         kladblok tonen, of het actieve venster erheen sturen
  parkeer [terug|lijst]    actief venster parkeren (minimaliseren) of terughalen
  zen [aan|uit]            zen-modus: balk verbergen, niet storen, rest dimmen
  vinyl [uit|auto <s>|auto uit]  draaitafel schermvullend; auto: als screensaver na <s> s stilstand met muziek (standaard 120)
  cassette | discman      cassettespeler of discman schermvullend (aan/uit); welke speler op de mediakaart staat kies je per scherm in Super+A
  sessie [aan|uit|bewaar|herstel]  apps na inloggen terugzetten (zonder argument: status)

Overig
  welcome                  welkomstmelding en sneltoetsen opnieuw tonen
  version                  geïnstalleerde versie
  help                     dit overzicht
TXT
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
    theme|thema)
        if [[ $# -eq 0 ]]; then panel theme; fi
        run kingstra-theme-switch "$@" ;;
    mode|modus)
        if [[ $# -eq 0 ]]; then panel mode; fi
        run kingstra-mode-switch "$@" ;;
    wallpaper|achtergrond) run kingstra-wallpaper "$@" ;;
    update|bijwerken)
        exec "$CONFIG_HOME/quickshell/package_upgrade.sh" "$@" ;;
    doctor|check)  run kingstra-doctor "$@" ;;
    snapshot)      run kingstra-snapshot "$@" ;;
    rollback|terug) run kingstra-rollback "$@" ;;
    refresh|herstel) run kingstra-refresh "$@" ;;
    restart|herstart) run kingstra-session-start restart-shell ;;
    install)
        repo="$(resolve_repo)" || { echo "kingstra: repo niet gevonden" >&2; exit 1; }
        exec bash "$repo/install.sh" "$@" ;;
    bediening|control)
        exec "$QS_MANAGER" open settings bediening ;;
    settings|instellingen)
        [[ -x "$QS_MANAGER" ]] || { echo "kingstra: qs_manager.sh niet gevonden" >&2; exit 127; }
        exec "$QS_MANAGER" open settings "${1:-}" ;;
    keys|toetsen|sneltoetsen) panel help ;;
    launcher) panel launcher ;;
    menu) panel menu ;;
    widgets|bureaublad)
        # Bureaubladwidgets (klok en media): aan, uit, of de plek van de klok.
        file="${XDG_STATE_HOME:-$HOME/.local/state}/kingstra/desktop-widgets.json"
        mkdir -p "$(dirname "$file")"
        python3 - "$file" "${1:-toggle}" "${2:-}" <<'PY'
import json, sys
path, action, arg = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    data = json.load(open(path))
except Exception:
    data = {}
spots = {"linksboven": "top-left", "rechtsboven": "top-right", "midden": "center",
         "linksonder": "bottom-left", "rechtsonder": "bottom-right"}
if action in ("aan", "on"):
    data["enabled"] = True
elif action in ("uit", "off"):
    data["enabled"] = False
elif action in ("toggle", "wissel"):
    data["enabled"] = not data.get("enabled", True)
elif action in ("klok", "clock"):
    spot = spots.get(arg, arg)
    if spot not in spots.values():
        sys.exit("plek: " + ", ".join(spots))
    data["clock"] = spot
elif action == "media":
    data["media"] = arg not in ("uit", "off")
else:
    sys.exit("gebruik: kingstra widgets aan|uit|klok <plek>|media aan|uit")
json.dump(data, open(path, "w"))
PY
        ;;
    eiland|island)
        # Kingstra-eiland: wat het toont. Zonder onderdeel: alles tegelijk.
        file="${XDG_STATE_HOME:-$HOME/.local/state}/kingstra/island.json"
        mkdir -p "$(dirname "$file")"
        python3 - "$file" "${1:-}" "${2:-}" <<'PY'
import json, sys
path, part, value = sys.argv[1], sys.argv[2], sys.argv[3]
keys = {"osd": "osd", "meldingen": "notifications", "notifications": "notifications", "live": "live"}
if part in ("aan", "uit", "on", "off"):
    part, value = "", part
if value not in ("aan", "uit", "on", "off") or (part and part not in keys):
    sys.exit("gebruik: kingstra eiland [osd|meldingen|live] aan|uit")
try:
    data = json.load(open(path))
except Exception:
    data = {}
on = value in ("aan", "on")
for key in ([keys[part]] if part else ["osd", "notifications", "live"]):
    data[key] = on
json.dump(data, open(path, "w"))
PY
        ;;
    indeling|layout)
        case "${1:-kies}" in
            kies|pick) panel snap ;;
            scroll|scrollen-wissel) exec "$CONFIG_HOME/hypr/scripts/layout-tool.sh" scroll ;;
            list|lijst) exec "$CONFIG_HOME/hypr/scripts/layout-tool.sh" list ;;
            *) exec "$CONFIG_HOME/hypr/scripts/layout-tool.sh" apply "$1" ;;
        esac ;;
    parkeer|park)
        case "${1:-}" in
            terug|last) exec python3 "$CONFIG_HOME/hypr/scripts/park-window.py" last ;;
            lijst|list) exec python3 "$CONFIG_HOME/hypr/scripts/park-window.py" list ;;
            *) exec python3 "$CONFIG_HOME/hypr/scripts/park-window.py" park ;;
        esac ;;
    kladblok|scratchpad)
        if [[ "${1:-}" == "stuur" || "${1:-}" == "send" ]]; then
            exec "$CONFIG_HOME/hypr/scripts/scratchpad.sh" send
        fi
        exec "$CONFIG_HOME/hypr/scripts/scratchpad.sh" toggle ;;
    zen)
        case "${1:-toggle}" in
            aan|on) exec "$CONFIG_HOME/hypr/scripts/zen.sh" on ;;
            uit|off) exec "$CONFIG_HOME/hypr/scripts/zen.sh" off ;;
            *) exec "$CONFIG_HOME/hypr/scripts/zen.sh" toggle ;;
        esac ;;
    sessie|session)
        tool="$CONFIG_HOME/hypr/scripts/session-restore.sh"
        case "${1:-status}" in
            aan|uit|on|off)
                file="${XDG_STATE_HOME:-$HOME/.local/state}/kingstra/session-settings.json"
                mkdir -p "$(dirname "$file")"
                python3 -c 'import json,sys; json.dump({"restore": sys.argv[2] in ("aan","on")}, open(sys.argv[1], "w"))' "$file" "$1"
                exec "$tool" status ;;
            bewaar|save) exec "$tool" save ;;
            herstel|restore) exec "$tool" restore ;;
            *) exec "$tool" status ;;
        esac ;;
    vinyl|platenspeler)
        if [[ "${1:-}" == "auto" || "${1:-}" == "screensaver" ]]; then
            # Na hoeveel seconden stilstand (met muziek aan) de draaitafel opent; uit = nooit.
            file="${XDG_STATE_HOME:-$HOME/.local/state}/kingstra/desktop-widgets.json"
            mkdir -p "$(dirname "$file")"
            exec python3 - "$file" "${2:-}" <<'PY'
import json, sys
path, arg = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(path))
except Exception:
    data = {}
if arg in ("uit", "off", "0"):
    data["vinylSaver"] = 0
elif arg.isdigit():
    data["vinylSaver"] = max(15, int(arg))
elif arg == "":
    print("screensaver: " + (f"na {data.get('vinylSaver', 120)} s" if data.get("vinylSaver", 120) else "uit"))
    sys.exit(0)
else:
    sys.exit("gebruik: kingstra vinyl auto <seconden>|uit")
json.dump(data, open(path, "w"))
PY
        fi
        case "${1:-toggle}" in
            uit|off|close) action=close ;;
            aan|on|open) action=open ;;
            *) action=toggle ;;
        esac
        exec qs ipc -p "$CONFIG_HOME/quickshell/TopBar.qml" call vinyl "$action" ;;
    cassette|cassettespeler|walkman)
        exec qs ipc -p "$CONFIG_HOME/quickshell/TopBar.qml" call vinyl cassette ;;
    discman|cdspeler|cd)
        exec qs ipc -p "$CONFIG_HOME/quickshell/TopBar.qml" call vinyl discman ;;
    quick|snel) panel tophover ;;
    welcome|welkom) run kingstra-welcome --force ;;
    version|versie|--version|-v)
        repo="$(resolve_repo)" || { echo "onbekend"; exit 0; }
        printf 'kingstra-dots %s (%s)\n' "$(tr -d '[:space:]' < "$repo/VERSION" 2>/dev/null || echo onbekend)" \
            "$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo '?')" ;;
    help|-h|--help) usage ;;
    *)
        printf 'kingstra: onbekend commando "%s"\n\n' "$cmd" >&2
        usage >&2
        exit 2 ;;
esac
