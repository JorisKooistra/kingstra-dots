+// An unzoomed output must not draw the unscaled copy of a floating window
+// belonging to a zoomed workspace. Normal cross-output floats stay unchanged
+// after the last zoom closes and these hooks are removed.
+bool kingstraWindowClipped(PHLWINDOW window, PHLMONITOR monitor) {
+    if (window && monitor && !window->m_pinned && window->m_workspace) {
+        const auto OWNER = window->m_workspace->m_monitor.lock();
+        const auto OVERVIEW = scrollOverviewForMonitor(OWNER);
+        const auto* CANVAS = OVERVIEW ? dynamic_cast<CScrollOverview*>(OVERVIEW.get()) : nullptr;
+        return CANVAS && CANVAS->isCanvasDesktop() && !CANVAS->isClosing() && OWNER != monitor;
+    }
+    return false;
+}
