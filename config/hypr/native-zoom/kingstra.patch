+bool kingstraWindowClipped(PHLWINDOW, PHLMONITOR);
+using KingstraWindowAt = PHLWINDOW (*)(const void*, const Vector2D&, uint16_t, PHLWINDOW);
+PHLWINDOW kingstraFilteredWindowAt(const void* thisptr, const Vector2D& pos, uint16_t properties, PHLWINDOW ignored, KingstraWindowAt original) {
+    PHLMONITOR monitor;
+    for (const auto& m : State::monitorState()->monitors())
+        if (m && m->logicalBox().containsPoint(pos)) { monitor=m; break; }
+    if (!monitor) return original(thisptr,pos,properties,ignored);
+    const auto& tracker = sc<const Desktop::CViewHitTester*>(thisptr)->m_tracker;
+    struct FilteredTracker final : Desktop::IViewStateTracker {
+        const Desktop::IViewStateTracker& source;
+        std::vector<PHLWINDOW> filtered;
+        FilteredTracker(const Desktop::IViewStateTracker& s) : source(s) {}
+        const std::vector<PHLWINDOW>& windows() const override { return filtered; }
+        const std::vector<PHLLS>& layers() const override { return source.layers(); }
+        const std::vector<PHLVIEWREF>& otherViews() const override { return source.otherViews(); }
+    } selected{tracker};
+    for (const auto& w : tracker.windows()) if (!kingstraWindowClipped(w,monitor)) selected.filtered.push_back(w);
+    if (selected.filtered.size()==tracker.windows().size()) return original(thisptr,pos,properties,ignored);
+    Desktop::CViewHitTester filteredTester{selected};
+    return original(&filteredTester,pos,properties,ignored);
+}
