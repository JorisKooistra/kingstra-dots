-- Personal Hyprland additions. Copy this file to user.lua (same folder) and
-- edit it there: user.lua is not tracked by git, so updates never touch it.
-- It loads after all Kingstra modules, so whatever you set here wins.
-- A mistake in user.lua is caught; the rest of the config keeps working.
--
-- Check your changes with: luac -p ~/.config/hypr/lua/user.lua

return {
    apply = function()
