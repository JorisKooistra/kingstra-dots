        -- hl.bind("SUPER + B", hl.dsp.exec_cmd("firefox"))

        -- Override a setting:
        -- hl.config({ general = { gaps_out = 12 } })

        -- Window rule:
        -- hl.window_rule({ name = "my-calc", match = { class = "^org.gnome.Calculator$" }, float = true })
    end,
}
