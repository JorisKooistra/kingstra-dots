# =============================================================================
# cava/config — Automatisch gegenereerd door matugen. Pas dit bestand NIET aan.
# =============================================================================

[general]
mode = normal
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
bar_height = 32
channels = stereo
sleep_timer = 0

[input]
method = pipewire
source = auto

[output]
method = ncurses
raw_target = /dev/stdout
data_format = binary
bit_format = 16bit
ascii_max_range = 1000
alsa_hint = default

[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '#8ed4c1'
gradient_color_2 = '#000000'
gradient_color_3 = '#becbae'
gradient_color_4 = '#e0ecce'
gradient_color_5 = '#7c9961'
gradient_color_6 = '#b1d093'
gradient_color_7 = '#000000'
gradient_color_8 = '#ffb4ab'

background = '#121410'

[smoothing]
monstercat = 0
waves = 0
gravity = 100
ignore_le = 0

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
