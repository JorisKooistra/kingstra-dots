# =============================================================================
# cava/config — Automatisch gegenereerd door matugen. Pas dit bestand NIET aan.
# =============================================================================

[general]
mode = normal
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
bar_height = 32
channels = stereo
sleep_timer = 0

[input]
method = pipewire
source = auto

[output]
method = ncurses
raw_target = /dev/stdout
data_format = binary
bit_format = 16bit
ascii_max_range = 1000
alsa_hint = default

[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '#bbcca4'
gradient_color_2 = '#ffffff'
gradient_color_3 = '#d0c6ae'
gradient_color_4 = '#eadfc7'
gradient_color_5 = '#6b5e36'
gradient_color_6 = '#d7c595'
gradient_color_7 = '#ffffff'
gradient_color_8 = '#ffb4ab'

background = '#151310'

[smoothing]
monstercat = 0
waves = 0
gravity = 100
ignore_le = 0

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
